		КонецЕсли;
		
		Массивnodes.Добавить(СтрШаблон("{%1}", СтрСоединить(МассивСвойстваУзла, "," + Символы.ПС + Символы.Таб + Символы.Таб + Символы.Таб)));
        
	КонецЦикла;
	
	
	ШаблонОсновныеСвойстваРебра = "			""id"": ""%1"",
		|			""label"": ""%2"", 
		|			""from"": ""%3"", 
		|			""to"": ""%4"",
		|			""URL"": ""%5""";
	//arrows: 'to', 
	СтатичныеСвойстваРебра = "		
		|			""length"": 200, 
		|			""width"": 3 
		//|			""smooth"": {
		//|				""enabled"": false,
		//|				""type"": ""dynamic""
		//,roundness: 0.5
		//|				}
		|";
	
	//ШаблонРебра = "
	//	|	{	id: '%1',
	//	|		label: '%2', 
	//	|		%3 
	//	|		from: '%4', 
	//	|		to: '%5',
	//	|		URL: '%6',
	//	|		arrows: 'to', 
	//	|		length: 400, 
	//	|		width: 3, 
