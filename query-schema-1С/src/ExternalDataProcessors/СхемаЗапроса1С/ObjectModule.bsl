	СтруктураНастроекВизуализации.Вставить("Ребра",	МассивРебра);
	СтруктураНастроекВизуализации.Вставить("Кластеры",	МассивКластеры);
	
	//!!!НастройкиОтображения = Новый Структура("Физика, БлокировкаПоВертикали, БлокировкаПоГоризонтали", ЭтотОбъект.Физика, ЭтотОбъект.БлокировкаПоВертикали, ЭтотОбъект.БлокировкаПоГоризонтали);
