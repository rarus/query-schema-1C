Процедура СформироватьНастройкуСтрелки(ВидСтрелки, МассивНастройкиСтрелок, НастройкиСтрелок)
	
	
	ВидСтрелкиJS = ?(ВидСтрелки = "Входящая","""to""", """from""");
	НастройкаСтрелки = Неопределено;
	Если НастройкиСтрелок.Свойство(ВидСтрелки, НастройкаСтрелки) Тогда
		Если ТипЗнч(НастройкаСтрелки) = Тип("Строка") Тогда
			МассивНастройкиСтрелок.Добавить(СтрШаблон("%1: {""enabled"": true, ""type"": ""%2""}", ВидСтрелкиJS, НастройкаСтрелки));
		Иначе
			Дополнение = "";							
			Если НастройкаСтрелки.Тип = "image" Тогда
				Дополнение = СтрШаблон(", ""imageHeight"":%1, ""imageWidth"":%2, ""src"":""%3""",Формат(НастройкаСтрелки.ВысотаКартинки, "ЧН=0; ЧГ=0"), Формат(НастройкаСтрелки.ШиринаКартинки, "ЧН=0; ЧГ=0"), СтрЗаменить(НастройкаСтрелки.Источник,"""","\""") );
				
			КонецЕсли;
			МассивНастройкиСтрелок.Добавить(СтрШаблон("%1: {""enabled"": true, ""type"": ""%2"" %3}", ВидСтрелкиJS, НастройкаСтрелки.Тип, Дополнение));	
		КонецЕсли;
	КонецЕсли;

