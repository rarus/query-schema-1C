	ВидыСоединений = Новый Соответствие();
	ВидыСоединений.Вставить(ТипСоединенияСхемыЗапроса.Внутреннее, СтрШаблон("o-%1[dashed]-o", НаправлениеСвязей));
	ВидыСоединений.Вставить(ТипСоединенияСхемыЗапроса.ЛевоеВнешнее, СтрШаблон("o-%1[dashed]-*", НаправлениеСвязей));
	ВидыСоединений.Вставить(ТипСоединенияСхемыЗапроса.ПолноеВнешнее, СтрШаблон("*-%1[dashed]-*", НаправлениеСвязей));
	ВидыСоединений.Вставить(ТипСоединенияСхемыЗапроса.ПравоеВнешнее, СтрШаблон("*-%1[dashed]-o", НаправлениеСвязей));
	
