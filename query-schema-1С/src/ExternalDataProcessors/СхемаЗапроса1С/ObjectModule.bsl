Функция СформироватьУзелПакета(ТекущийУзел, МассивРебра, МассивУзлы, X, Y, КоординатыУзлов, ИдентификаторПакета, НастройкиОтображенияУзловИРебер, ИменаВременныхТаблиц, МассивИдентификаторовРебер, ЭтоУзелВременнойТаблицы, ИскатьУзелВыборки,ЭтоФинальныйУзелВыборки)
	
	НастройкиСпецУзловИРебер 	= НастройкиОтображенияУзловИРебер.НастройкиСпецУзловИРебер;
	БазовыйСдвигУзла 			= НастройкиОтображенияУзловИРебер.БазовыйСдвигУзла;
	
	ИсходныйИдентификаторУзла 	= ТекущийУзел["id"];	
	ИмяУзла 					= ТекущийУзел["name"];	
	ИдентификаторРодительскогоУзла = ТекущийУзел["parentid"];
	ТипУзла 					= ТекущийУзел["type"];
	ТекстЗапросаУзла			= ТекущийУзел["sql"];
	ИдентификаторУзла = ИсходныйИдентификаторУзла;
	
	Если ТипУзла = "CREATE" ИЛИ ТипУзла = "DROP" Тогда
		Возврат Неопределено;	
	ИначеЕсли ТипУзла = "INSERT" Тогда
		ИдентификаторПакета = СтрШаблон("Пакет_%1",ИдентификаторУзла);
		ЭтоУзелВременнойТаблицы = Истина;
		ИменаВременныхТаблиц.Добавить(ИдентификаторУзла);
		//ИдентификаторПакета = СтрЗаменить(ИдентификаторУзла,ИдентификаторINSERT,"");
		
		ДобавлятьИдентификаторПакета = Ложь;
		
	ИначеЕсли ИменаВременныхТаблиц.Найти(ИдентификаторУзла) = Неопределено Тогда // НЕ СтрНачинаетсяС(ИдентификаторУзла,"_") Тогда
		ИдентификаторУзла = СтрШаблон("%1_%2", ИдентификаторПакета, ИдентификаторУзла);
		
		Если ТипУзла = "SELECT" И ИскатьУзелВыборки Тогда
			ЭтоФинальныйУзелВыборки 	= Истина;
		КонецЕсли;
	КонецЕсли;
	
	ИскатьУзелВыборки 		= Ложь;
	
	НастройкиОтображенияУзла = Новый Структура;
	ТекНастройки = Неопределено;
	ИмяНастройки = ?(ЭтоФинальныйУзелВыборки, "SELECTВыборки", ТипУзла);
	
	Если НастройкиСпецУзловИРебер.Свойство(ИмяНастройки,ТекНастройки) Тогда
		
		Для каждого КлючЗначение Из ТекНастройки Цикл
			НастройкиОтображенияУзла.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;		
		
	КонецЕсли;
	
	
	XНачальная = 0;
	YНачальная = 0;
	СдвигВнутриРодителя = 0;
	КоординатыРодителя = КоординатыУзлов[ИдентификаторРодительскогоУзла];
	Если КоординатыРодителя <> Неопределено Тогда
		XНачальная = КоординатыРодителя.X;
		YНачальная = КоординатыРодителя.Y;
		СдвигВнутриРодителя = КоординатыРодителя.Сдвиг;
	КонецЕсли;
	
	Если ЭтотОбъект.НаправлениеПостроения = 0 Тогда     //Узлы по-вертикали, пакеты по-горизонтали(0)
		Y = YНачальная + ЭтотОбъект.СдвигУзла; //*?(ЭтоФинальныйУзелВыборки,0.5,1);
		X = X + СдвигВнутриРодителя;		
	Иначе 		//Пакеты по-вертикали, узлы по-горизонтали(1)
		X = XНачальная + ЭтотОбъект.СдвигУзла;
		Y = Y + СдвигВнутриРодителя;		
	КонецЕсли;
	
	Если КоординатыРодителя <> Неопределено Тогда
		КоординатыРодителя.Вставить("Сдвиг",СтрДлина(ИмяУзла)*15); 
	КонецЕсли;
	//	Y = Y - БазовыйСдвигУзла*?(ЭтоФинальныйУзелВыборки,0.5,1);
	//Иначе
	//	Y = КоординатыРодителя.Y - БазовыйСдвигУзла*?(ЭтоФинальныйУзелВыборки,0.5,1);
	//КонецЕсли;
	
	КоординатыУзлов.Вставить(ИсходныйИдентификаторУзла,Новый Структура("X,Y, Сдвиг",X,Y, 0));
	
	ДобавитьУзел(МассивУзлы, ИдентификаторУзла, ИмяУзла, X, Y, НастройкиОтображенияУзла, ТекстЗапросаУзла);
	
	ТекИдентификаторНачало = ИдентификаторУзла;
	
	Отношения = ТекущийУзел["relations"];
	
	МассивВходящихИдентификаторов = Новый Массив;				
	Для каждого Связь Из Отношения Цикл
		ИсходныйИдентификаторКонец = Связь["id"];
		Если НЕ ЗначениеЗаполнено(ИсходныйИдентификаторКонец) Тогда
			Продолжить;				
		КонецЕсли;					
		
		ТекИдентификаторРебра 	= СтрШаблон("%1_Ребро_%2_%3",ИдентификаторПакета, ИсходныйИдентификаторУзла, ИсходныйИдентификаторКонец);                                        
		Если ИменаВременныхТаблиц.Найти(ИсходныйИдентификаторКонец) <> Неопределено Тогда //СтрНачинаетсяС(ИсходныйИдентификаторКонец,"_") Тогда
			ТекИдентификаторКонец = ИсходныйИдентификаторКонец;	
		Иначе
			ТекИдентификаторКонец = СтрШаблон("%1_%2", ИдентификаторПакета, ИсходныйИдентификаторКонец);		
		КонецЕсли;
		
		
		НастройкиОтображенияРебра = Новый Структура;
		
		Если ИменаВременныхТаблиц.Найти(ТекИдентификаторКонец) = Неопределено Тогда
			МассивВходящихИдентификаторов.Добавить(ТекИдентификаторКонец);
		Иначе						
			Для каждого КлючЗначение Из НастройкиСпецУзловИРебер.РеброВременнойТаблицы Цикл
				НастройкиОтображенияРебра.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;						
		КонецЕсли;
		
		Если ТипУзла = "CREATE" Тогда
			НастройкиОтображенияРебра.Вставить("ВидСтрелки","to");
		Иначе
			НастройкиОтображенияРебра.Вставить("ВидСтрелки","from");						
		КонецЕсли;
		
		ОписаниеРебра = "";
		ДобавитьРебро(МассивРебра, МассивИдентификаторовРебер, ТекИдентификаторРебра, ТекИдентификаторНачало, ТекИдентификаторКонец, ОписаниеРебра, НастройкиОтображенияРебра);
				
	КонецЦикла;
	
	Связи = ТекущийУзел["joins"];
	Для каждого Связь Из Связи Цикл
		ИсходныйИдентификаторКонец 	= Связь["id"];
		
		ТипСвязи 	= Связь["type"];
		УзелСвязи 	= Связь["on"];		
		
		ТекИдентификаторРебра 	= СтрШаблон("%1_Ребро_%2_%3_%4",ИдентификаторПакета, УзелСвязи, ТипСвязи, ИсходныйИдентификаторКонец);                                        
		
		ТекИдентификаторНачалоВложенный = УзелСвязи;
		Если ИменаВременныхТаблиц.Найти(УзелСвязи) = Неопределено Тогда//НЕ СтрНачинаетсяС(УзелСвязи,"_") Тогда
			ТекИдентификаторНачалоВложенный = СтрШаблон("%1_%2", ИдентификаторПакета, УзелСвязи);		
		КонецЕсли;
		
		ТекИдентификаторКонец = ИсходныйИдентификаторКонец;	
		Если ИменаВременныхТаблиц.Найти(ИсходныйИдентификаторКонец) = Неопределено Тогда //СтрНачинаетсяС(ИсходныйИдентификаторКонец,"_") Тогда
			ТекИдентификаторКонец = СтрШаблон("%1_%2", ИдентификаторПакета, ИсходныйИдентификаторКонец);		
		КонецЕсли;
		
		
		НастройкиОтображенияРебра = Новый Структура;      
		Для каждого КлючЗначение Из НастройкиСпецУзловИРебер.РеброСвязи Цикл
			НастройкиОтображенияРебра.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;	
		Если ТипСвязи = "INNER JOIN" Тогда
			НастройкиСтрелок = Новый Структура("Входящая, Исходящая", "circle","circle");
			НастройкиОтображенияРебра.Вставить("НастройкиСтрелок", НастройкиСтрелок);							
		ИначеЕсли ТипСвязи = "LEFT JOIN" ИЛИ ТипСвязи = "LEFT OUTER JOIN" Тогда
			НастройкиСтрелок = Новый Структура("Входящая", "circle");
			НастройкиСтрелок.Вставить("Исходящая", Новый Структура("Тип, ВысотаКартинки, ШиринаКартинки, Источник", "image", 20,20,
			//"https://img.icons8.com/?size=100&id=22037&format=png&color=000000" 
			//"https://img.icons8.com/?size=100&id=22010&format=png&color=000000"
			//"data:image/svg+xml,%3Csvg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 100 100""%3E%3Ccircle cx=""50"" cy=""50"" r=""45"" fill=""%23f0f0f0"" stroke=""%23333"" stroke-width=""2""/%3E%3Ctext x=""50"" y=""50"" font-size=""20"" font-family=""Arial, sans-serif"" text-anchor=""middle"" dominant-baseline=""middle"" fill=""%23333""%3EText%3C/text%3E%3C/svg%3E"
			"data:image/svg+xml,%3Csvg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 100 100""%3E%3Ccircle cx=""50"" cy=""50"" r=""45"" fill=""%23f0f0f0"" stroke=""red"" stroke-width=""4""/%3E%3Ctext x=""50"" y=""50"" font-size=""20"" font-family=""Arial, sans-serif"" text-anchor=""middle"" dominant-baseline=""middle"" fill=""%23333""%3E%3C/text%3E%3C/svg%3E"
			));
			НастройкиОтображенияРебра.Вставить("НастройкиСтрелок", НастройкиСтрелок);
			//	from: {enabled: true, type: 'image',
			//imageHeight:30, imageWidth:30,
			//src:'https://img.icons8.com/?size=100&id=22010&format=png&color=000000'
			//
		КонецЕсли;
		
		ОписаниеРебра = ?(Связь["sql"]<>Неопределено, Связь["sql"], ТипСвязи);
		ДобавитьРебро(МассивРебра, МассивИдентификаторовРебер, ТекИдентификаторРебра, ТекИдентификаторНачалоВложенный, ТекИдентификаторКонец, ОписаниеРебра, НастройкиОтображенияРебра);
		
		
		
	КонецЦикла;
	
	
	Результат = Новый Структура("МассивВходящихИдентификаторов,ИдентификаторУзла", МассивВходящихИдентификаторов, ИдентификаторУзла);
					
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьУзел(МассивУзлы, Идентификатор, Имя, X, Y, НастройкиОтображенияУзла, Знач Заголовок = "")

	ПолныйЗаголовок = Заголовок;
	УкоротитьЗаголовок(Заголовок, "узел", 10);	
	
	СтруктураУзла = Новый Структура("Идентификатор, Имя, Заголовок, ПолныйЗаголовок, НавигационнаяСсылка", Идентификатор, Имя, Заголовок, ПолныйЗаголовок);
	
	НастройкиОтображенияУзла.Вставить("X",X);
	НастройкиОтображенияУзла.Вставить("Y",Y);
	СтруктураУзла.Вставить("НастройкиОтображения",НастройкиОтображенияУзла);
	МассивУзлы.Добавить(СтруктураУзла);
	
КонецПроцедуры

Процедура ДобавитьРебро(МассивРебра, МассивИдентификаторовРебер, ИдентификаторРебра, ИдентификаторНачало, ИдентификаторКонец, ЗаголовокРебра, НастройкиОтображенияРебра = Неопределено, НавигационнаяСсылкаРебра = "")

	Если МассивИдентификаторовРебер.Найти(ИдентификаторРебра) <> Неопределено Тогда
		Если Отладка Тогда
			Сообщить(СтрШаблон("Ребро с идентификатором %1 уже существует, пропускаем", ИдентификаторРебра));	
		КонецЕсли;
		Возврат;
	Иначе
		МассивИдентификаторовРебер.Добавить(ИдентификаторРебра);	
	КонецЕсли;
		
	ИмяРебра = ""; 
	
	ПолныйЗаголовок = ЗаголовокРебра;
	УкоротитьЗаголовок(ЗаголовокРебра, "ребро", 10);	
	
	СтруктураРебра = Новый Структура("Идентификатор, Имя, Заголовок, ПолныйЗаголовок, ИдентификаторНачало, ИдентификаторКонец, НавигационнаяСсылка", ИдентификаторРебра, ИмяРебра, ЗаголовокРебра, ПолныйЗаголовок, ИдентификаторНачало, ИдентификаторКонец, НавигационнаяСсылкаРебра);
	Если ЗначениеЗаполнено(НастройкиОтображенияРебра) Тогда
		НастройкиОтображения = НастройкиОтображенияРебра;
		Для каждого КлючЗначение Из НастройкиОтображенияРебра Цикл
			НастройкиОтображения.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	    СтруктураРебра.Вставить("НастройкиОтображения",НастройкиОтображения);
	КонецЕсли;
	МассивРебра.Добавить(СтруктураРебра);

КонецПроцедуры

Процедура УкоротитьЗаголовок(Заголовок, ИмяЭлемента = "узел", ЛимитСтрок = 10)
	
	Если СтрЧислоСтрок(Заголовок) > ЛимитСтрок Тогда
		МассивПолныйЗаголовок = СтрРазделить(Заголовок, Символы.ПС);
		МассивУкороченныйЗаголовок = Новый Массив;
		Для н = 0 По ЛимитСтрок-1 Цикл
			МассивУкороченныйЗаголовок.Добавить(МассивПолныйЗаголовок[н]);	
		КонецЦикла;
		
		МассивУкороченныйЗаголовок.Добавить("...");
		МассивУкороченныйЗаголовок.Добавить(СтрШаблон(" и ещё %1 строк, <font color=""red"">чтобы увидеть весь текст нажмите дважды на %2</font>",СтрЧислоСтрок(Заголовок)-ЛимитСтрок, ИмяЭлемента));
		Заголовок = СтрСоединить(МассивУкороченныйЗаголовок, Символы.ПС);
	КонецЕсли;	

КонецПроцедуры

// Нет ссылок на функцию
Функция ПолучитьИдентификаторУзла(УзелСсылка)
	
	Если УзелСсылка.Пустая() Тогда
		ИдентификаторУзла = "ПустойИдентификатор";	
	Иначе
		ИдентификаторУзла = Строка(УзелСсылка.УникальныйИдентификатор());
	КонецЕсли;
	Возврат ИдентификаторУзла;

