#Область ПостроениеVISJS_Параметры

Функция СформироватьДиаграммуVISJS(СхемаЗапросаVIS, Узлы, Ребра, ПолеСхемыVISJS) Экспорт
	
	СтруктураНастроекВизуализации = ПолучитьСтруктуруНастроекВизуализации(СхемаЗапросаVIS);
	Если СтруктураНастроекВизуализации=Неопределено Тогда
		УзлыJS  = "";
		РебраJS = "";
		ПолеСхемыVISJS = 
		"<html>
		|<head>
		|<p>Нет данных</p>
		|</head>
		|
		|</html>";
		Возврат Ложь;
	КонецЕсли;
	
	Результат = СформироватьТекстПоляHTMLГрафа(СтруктураНастроекВизуализации);
	Узлы  = Результат.nodes;
	Ребра = Результат.edges;
	ПолеСхемыVISJS = Результат.HTML;
	Возврат Истина;
	
КонецФункции // СформироватьДиаграммуVISJS()

Функция ПолучитьСтруктуруНастроекВизуализации(СхемаЗапросаVIS)
	
	НастройкиСпецУзловИРебер = Новый Структура;
	НастройкиСпецУзловИРебер.Вставить("CREATE", 		Новый Структура("СвойстваЦвета", Новый Структура("ЦветФона", "#FF2299")));
	НастройкиСпецУзловИРебер.Вставить("INSERT", 		Новый Структура("СвойстваЦвета", Новый Структура("ЦветФона", "#FF9922")));
	НастройкиСпецУзловИРебер.Вставить("SELECT", 		Новый Структура("СвойстваЦвета", Новый Структура("ЦветФона", "#FF9999")));
	НастройкиСпецУзловИРебер.Вставить("TABLE", 			Новый Структура("СвойстваЦвета", Новый Структура("ЦветФона", "#CEEBCE"))); //"#33FF33" - слишком кислотный, поставил пастельный
	НастройкиСпецУзловИРебер.Вставить("UNION", 			Новый Структура("СвойстваЦвета,Форма", Новый Структура("ЦветФона", "#229999"),"ellipse"));
	
	НастройкиСпецУзловИРебер.Вставить("SELECTВыборки", 			Новый Структура("СвойстваЦвета, Форма, ТолщинаЛинии", Новый Структура("ЦветФона", "#FF55FF"),"star", 3));
	
	НастройкиСпецУзловИРебер.Вставить("РеброВременнойТаблицы", 	Новый Структура("СвойстваЦвета", Новый Структура("Цвет, ЦветНаведения", "green", "#77CC77")));
	НастройкиСпецУзловИРебер.Вставить("РеброСвязи", 	Новый Структура("СвойстваЦвета", Новый Структура("Цвет, ЦветНаведения", "red", "#CC7777")));
	//['ellipse', 'box', 'circle', 'database', 'diamond', 'dot', 'square', 'star', 'text', 'triangle', 'triangleDown', 'hexagon'],
	
    Множитель = 5;
	БазовыйСдвигПоГоризонтали 	= 50*Множитель; 
	ВнутреннийСдвигПоВертикали 	= 20*Множитель;
