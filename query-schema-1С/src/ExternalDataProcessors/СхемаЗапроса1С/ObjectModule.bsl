Функция ВидыСоединенияЗапроса()
	
	ВидыСоединений = Новый Соответствие();
	ВидыСоединений.Вставить(ТипСоединенияСхемыЗапроса.Внутреннее, "INNER JOIN");
	ВидыСоединений.Вставить(ТипСоединенияСхемыЗапроса.ЛевоеВнешнее, "LEFT JOIN");
	ВидыСоединений.Вставить(ТипСоединенияСхемыЗапроса.ПолноеВнешнее, "FULL JOIN");
	ВидыСоединений.Вставить(ТипСоединенияСхемыЗапроса.ПравоеВнешнее, "RIGHT JOIN");
	
	Возврат ВидыСоединений;
	
