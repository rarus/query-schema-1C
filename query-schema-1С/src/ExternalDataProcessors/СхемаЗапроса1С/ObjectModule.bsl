Функция ОбработатьСтрокуДляHTML(Строка)

	Строка = СтрЗаменить(Строка,Символы.ПС, "<br>");
	Строка = СтрЗаменить(Строка, """","\""");
	Строка = СтрЗаменить(Строка, Символы.Таб,"    " ); 
    Возврат Строка;
	
