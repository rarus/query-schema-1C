КонецФункции // ВсеТипыТаблицБД()

Функция ПолучитьБлокЗапроса(ИзмененныйЗапрос, РезультатПоиска)
	
	Если Прав(СокрЛП(РезультатПоиска.Значение), 1)<>"(" Тогда
		Возврат РезультатПоиска.Значение;
	КонецЕсли;
	
	ТекущийБлок  = "";
	ОбщаяДлина   = СтрДлина(ИзмененныйЗапрос);
	СтатусСкобок = 1;
	
	// Найдем закрывающую скобку
	Для Индекс=РезультатПоиска.НачальнаяПозиция+РезультатПоиска.Длина По ОбщаяДлина Цикл
		
		ТекущийСимвол = Сред(ИзмененныйЗапрос, Индекс, 1);
		
		Если ТекущийСимвол="(" Тогда
			СтатусСкобок  = СтатусСкобок + 1;
		ИначеЕсли ТекущийСимвол=")" Тогда
			СтатусСкобок  = СтатусСкобок - 1;
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если СтатусСкобок<=0 Тогда
			ТекущийБлок = Сред(ИзмененныйЗапрос, РезультатПоиска.НачальнаяПозиция, Индекс - РезультатПоиска.НачальнаяПозиция + 1);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПустаяСтрока(ТекущийБлок) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = '{%1} Не найдена закрывающая скобка параметров временной таблицы: %2'"), РезультатПоиска.НачальнаяПозиция, СокрЛП(РезультатПоиска.Значение));
	КонецЕсли;
	
	Возврат ТекущийБлок;
	
КонецФункции // ПолучитьБлокЗапроса()

Функция ПеренестиВложенныеЗапросыКакСоединения(ИзмененныйЗапрос, ТекущийБлок, ИмяТаблицы, ИменаТаблиц)
	
	БлокСоединений = "";
	ШаблонЗамены   = "__EXT_FILTER_№___";
	
	Пока ИСТИНА Цикл
		
		ПоискВложенногоЗапроса = СтрНайтиПоРегулярномуВыражению(ТекущийБлок, "\((?=\s*(?:ВЫБРАТЬ|SELECT)\s+)",,,, ИСТИНА, ИСТИНА);
		Если ПоискВложенногоЗапроса.НачальнаяПозиция = 0 Тогда
			Возврат БлокСоединений;
		КонецЕсли;
		
		ВложенныйЗапрос = ПолучитьБлокЗапроса(ТекущийБлок, ПоискВложенногоЗапроса);
		НомерТаблицы    = Формат(ИменаТаблиц.Количество()+1, "ЧН=0; ЧГ=0");
		ИмяВложЗапроса  = СтрЗаменить(ШаблонЗамены, "№", НомерТаблицы);
		ИменаТаблиц.Вставить(ИмяВложЗапроса, ИмяТаблицы+".Отбор");//СокрЛП(ВложенныйЗапрос)
		
		БлокСоединений = БлокСоединений + Символы.ПС + "ВНУТРЕННЕЕ СОЕДИНЕНИЕ "+ВложенныйЗапрос+" КАК " + ИмяВложЗапроса + Символы.ПС+"ПО ИСТИНА";
		ТекущийБлок    = СтрЗаменить(ТекущийБлок, ВложенныйЗапрос, "(&"+ИмяВложЗапроса+")");
		
	КонецЦикла;
	
	Возврат БлокСоединений;
	
КонецФункции // ПеренестиВложенныеЗапросыКакСоединения()

#КонецОбласти

#Область ПостроениеPlantUML_Запрос1С

Функция Сформировать_ТекстPlantUML_СхемаЗапроса1С(СхемаЗапроса, ИменаТаблиц) Экспорт
	
	СписокТаблиц = Новый ТаблицаЗначений();
	СписокТаблиц.Колонки.Добавить("Имя");
	СписокТаблиц.Колонки.Добавить("Номер");
	СписокТаблиц.Колонки.Добавить("ЭтоВременнаяТаблица");
	СписокТаблиц.Колонки.Добавить("ПакетЗапроса");
	
	НомерЗапроса = 0;
	ШаблонНаименованияГруппы = НСтр("ru = 'Пакет запроса %1'");
	СоздаватьГруппы = СхемаЗапроса.ПакетЗапросов.Количество() > 1;
	
	ЧастиТекста = Новый Массив;
	ЧастиТекста.Добавить("@startuml");
	ЧастиТекста.Добавить(ПараметрыТекстаPlantUML());
	Если ЭтотОбъект.КомпактныйРежим Тогда
		ЧастиТекста.Добавить("together{");
	КонецЕсли;

	Для Каждого ПакетЗапроса Из СхемаЗапроса.ПакетЗапросов Цикл

		ИспользуемыеВременныеТаблицы = Новый Массив();
		НомерЗапроса = НомерЗапроса + 1;

		Если ТипЗнч(ПакетЗапроса) = Тип("ЗапросУничтоженияТаблицыСхемыЗапроса") Тогда

			Продолжить;

		КонецЕсли;

		Если Не ПустаяСтрока(ПакетЗапроса.ТаблицаДляПомещения) Тогда

			НазваниеГруппы = ПакетЗапроса.ТаблицаДляПомещения;
			//НаименованиеТаблицы = ПакетЗапроса.ТаблицаДляПомещения;
			НоваяСтрока = СписокТаблиц.Добавить();
			НоваяСтрока.Имя = НазваниеГруппы;
			НоваяСтрока.Номер = 0;
			НоваяСтрока.ЭтоВременнаяТаблица = Истина;

		Иначе

			НазваниеГруппы = СтрШаблон(ШаблонНаименованияГруппы, Формат(НомерЗапроса, "ЧГ=;"));

		КонецЕсли;

		СозданиеНовойГруппыПоТекстуЗапроса1С(
			ЧастиТекста,
			ПакетЗапроса,
			НазваниеГруппы,
			СписокТаблиц,
			СоздаватьГруппы,
			ИспользуемыеВременныеТаблицы,
			ИменаТаблиц);

		Если ЭтотОбъект.КомпактныйРежим Тогда

			Для Каждого ИспользуемаяВременнаяТаблица Из ИспользуемыеВременныеТаблицы Цикл

				ЧастиТекста.Добавить(СоединениеПакетовЗапроса(ИспользуемаяВременнаяТаблица, НазваниеГруппы));

			КонецЦикла;

		КонецЕсли;

	КонецЦикла;
	
	Если ЭтотОбъект.КомпактныйРежим Тогда
		ЧастиТекста.Добавить("}");
	КонецЕсли;
	ЧастиТекста.Добавить("@enduml");
	
	Возврат СтрСоединить(ЧастиТекста, Символы.ПС);
	
КонецФункции // Сформировать_ТекстPlantUML_СхемаЗапроса1С()

Функция ПараметрыТекстаPlantUML()
	
	НачалоТекста = 
	"hide empty members 
	|hide circle
	|skinparam class {
	|BackgroundColor White
	|  BorderColor Black
	|  FontSize 12
	|  Padding 10
	|  Margin 10
	|}
	|skinparam package {
	|  BorderColor Black
	|  FontSize 14
	|  FontStyle bold
	|  Padding 15
	|  Margin 10
	|} 
	|skinparam defaultTextAlignment center
	|set namespaceSeparator none
	|skinparam componentStyle rectangle";
	
	Если ЭтотОбъект.ПрямыеСтрелки Тогда
		НачалоТекста = НачалоТекста + "
			|skinparam linetype ortho";
	КонецЕсли;
	
	Возврат НачалоТекста;
	
КонецФункции // ПараметрыТекстаPlantUML()

Процедура СозданиеНовойГруппыПоТекстуЗапроса1С(
		ЧастиТекста,
		ПакетЗапроса,
		НазваниеГруппы,
		СписокТаблиц,
		СоздаватьГруппу,
		ИспользуемыеВременныеТаблицы,
		ИменаТаблиц,
		ПредставлениеТаблицы = "")

	СписокСоединений = ВидыСоединенияЗапроса1С();
	ЭтоВременнаяТаблица = СписокТаблиц.НайтиСтроки(Новый Структура("Имя", НазваниеГруппы)).Количество() > 0;
	ЭтоДобавление = Ложь;
	Попытка
		Если Не ПустаяСтрока(ПакетЗапроса.ТаблицаДляДобавления) Тогда
			ЭтоДобавление = СписокТаблиц.НайтиСтроки(
				Новый Структура("Имя,ЭтоВременнаяТаблица", ПакетЗапроса.ТаблицаДляДобавления, Истина)).Количество() > 0;
			Если ЭтоДобавление Тогда
				НазваниеГруппы = СтрЗаменить(НазваниеГруппы, " ", "");
			Иначе
				НазваниеГруппы = ПакетЗапроса.ТаблицаДляДобавления;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если СоздаватьГруппу Тогда
		Если ЭтоДобавление Тогда
			ЧастиТекста.Добавить(СтрШаблон("package """" as %1 <<Rectangle>> #White {", НазваниеГруппы));
		ИначеЕсли Не ЭтоВременнаяТаблица И ПустаяСтрока(ПредставлениеТаблицы) Тогда
			ЧастиТекста.Добавить(СтрШаблон("package ""%1"" <<Frame>> #e9e8e4 {", НазваниеГруппы));
		Иначе
			Если ПустаяСтрока(ПредставлениеТаблицы) Тогда
				ЧастиТекста.Добавить(СтрШаблон("package ""%1"" <<Frame>> #White {", НазваниеГруппы));
			Иначе
				ЧастиТекста.Добавить(СтрШаблон("package ""%1"" as %2 <<Frame>> #White {", ПредставлениеТаблицы, НазваниеГруппы));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	СписокТаблицСвязями = Новый Массив();
	ТаблицыВыводаПакета = Новый Массив();

	ГруппироватьОбъединения = ПакетЗапроса.Операторы.Количество() > 1;
	СписокОбъединений = Новый ТаблицаЗначений();
	СписокОбъединений.Колонки.Добавить("ИмяГруппы");
	СписокОбъединений.Колонки.Добавить("ТипОбъединения");
	
	СписокСоединенийИсточника = Новый ТаблицаЗначений();
	СписокСоединенийИсточника.Колонки.Добавить("ИмяТаблицы");
	СписокСоединенийИсточника.Колонки.Добавить("ТипСоединения");
	СписокСоединенийИсточника.Колонки.Добавить("Условие");
	СписокСоединенийИсточника.Колонки.Добавить("НомерСтроки");
	
	Для Каждого Оператор Из ПакетЗапроса.Операторы Цикл

		Если ГруппироватьОбъединения Тогда
			НазваниеГруппыОбъединения = СтрШаблон(
			"Объединение%1%2", СтрЗаменить(НазваниеГруппы, " ", ""), Формат(СписокОбъединений.Количество() + 1, "ЧГ=0"));
			
			Если Оператор.ТипОбъединения = ТипОбъединенияСхемыЗапроса.Объединить Тогда
				ЗаголовокОбъединения = НСтр("ru = 'ОБЪЕДИНИТЬ РАЗЛИЧНЫЕ'");
			Иначе
				ЗаголовокОбъединения = НСтр("ru = 'ОБЪЕДИНИТЬ ВСЕ'");
			КонецЕсли;
			
			ЧастиТекста.Добавить(СтрШаблон("package ""%1"" as %2 <<Rectangle>> #White {", ЗаголовокОбъединения, НазваниеГруппыОбъединения));
			НоваяСтрока = СписокОбъединений.Добавить();
			НоваяСтрока.ИмяГруппы = НазваниеГруппыОбъединения;
			НоваяСтрока.ТипОбъединения = Оператор.ТипОбъединения;
			
		КонецЕсли;
		Для Каждого ТекущаяСтрокаТаблица Из СписокТаблиц Цикл
			
			ТекущаяСтрокаТаблица.Номер = ТекущаяСтрокаТаблица.Номер + 1;
			
		КонецЦикла;

		ПредыдущийИсточникТаблицы = "";
		СписокПсевдонимов = Новый Массив();
		Для Каждого ИсточникДанных Из Оператор.Источники Цикл

			Если ТипЗнч(ИсточникДанных.Источник) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда

				ИмяТаблицыИсточникаОбъект = ИницализацияВложенногоЗапроса(
					ЧастиТекста, СписокТаблиц, ИсточникДанных, ИспользуемыеВременныеТаблицы, ИменаТаблиц, НазваниеГруппы);

			Иначе

				ИмяТаблицыИсточникаОбъект = ИмяТаблицыИсточникаДанныхЗапроса(
					ИсточникДанных.Источник.ИмяТаблицы,
					СписокТаблиц);
				Если ТаблицыВыводаПакета.Найти(ИмяТаблицыИсточникаОбъект) = Неопределено Тогда
					ТаблицыВыводаПакета.Добавить(ИмяТаблицыИсточникаОбъект);
					ЧастиТекста.Добавить(
						ИницализацияТаблицы(ИмяТаблицыИсточникаОбъект, ИсточникДанных.Источник.ИмяТаблицы, ИменаТаблиц));
					ДобавитьСвязьСВременнойТаблицей(
						ЧастиТекста,
						СписокТаблиц,
						ИмяТаблицыИсточникаОбъект,
						ИсточникДанных.Источник.ИмяТаблицы);
				КонецЕсли;
			
			КонецЕсли;

			СписокСоединенийИсточника.Очистить();
			Для Каждого Соединение Из ИсточникДанных.Соединения Цикл

				ЭтоВложенныйЗапрос = ТипЗнч(Соединение.Источник.Источник) = Тип("ВложенныйЗапросСхемыЗапроса");
				Если ЭтоВложенныйЗапрос Тогда
					ИмяТаблицыСоеднинения = ИницализацияВложенногоЗапроса(
						ЧастиТекста, СписокТаблиц, Соединение.Источник, ИспользуемыеВременныеТаблицы, ИменаТаблиц, НазваниеГруппы);
				Иначе
					ИмяТаблицыСоеднинения = ИмяТаблицыИсточникаДанныхЗапроса(
						Соединение.Источник.Источник.ИмяТаблицы,
						СписокТаблиц);
					Если ТаблицыВыводаПакета.Найти(ИмяТаблицыСоеднинения) = Неопределено Тогда
						ТаблицыВыводаПакета.Добавить(ИмяТаблицыСоеднинения);
						ЧастиТекста.Добавить(
							ИницализацияТаблицы(ИмяТаблицыСоеднинения, Соединение.Источник.Источник.ИмяТаблицы, ИменаТаблиц));
						ДобавитьСвязьСВременнойТаблицей(
							ЧастиТекста,
							СписокТаблиц,
							ИмяТаблицыСоеднинения,
							Соединение.Источник.Источник.ИмяТаблицы);
					КонецЕсли;
				КонецЕсли;
				
				СписокПсевдонимов.Добавить(Соединение.Источник.Источник.Псевдоним);
				
				НайденныеСоединения = СписокСоединенийИсточника.НайтиСтроки(
					Новый Структура("ИмяТаблицы,ТипСоединения", Соединение.Источник.Источник.Псевдоним, Соединение.ТипСоединения));
				
				Если НайденныеСоединения.Количество() > 0 Тогда
					НайденныеСоединения[0].Условие = СтрШаблон("%1\nИ %2", НайденныеСоединения[0].Условие, Строка(Соединение.Условие));
					Продолжить;
				КонецЕсли;
				
				Если СписокСоединенийИсточника.Количество() > 0
					И ЭтотОбъект.ВыводитьУсловияСоединения Тогда
					ПредыдущаяСвязь = СписокСоединенийИсточника[СписокСоединенийИсточника.Количество() - 1];
					ЧастиТекста.Вставить(
						ПредыдущаяСвязь.НомерСтроки,
						ОписаниеУсловияСвязи(ПредыдущаяСвязь.Условие));
				КонецЕсли;
				
				СоединениеСИточником = СписокСоединенийИсточника.Добавить();
				СоединениеСИточником.ИмяТаблицы = Соединение.Источник.Источник.Псевдоним;
				СоединениеСИточником.ТипСоединения = Соединение.ТипСоединения;
				СоединениеСИточником.Условие = Строка(Соединение.Условие);
				СоединениеСИточником.НомерСтроки = ЧастиТекста.Количество() + 1;
				
				ВидСоединения = СписокСоединений.Получить(Соединение.ТипСоединения);
				Если ВидСоединения = Неопределено Тогда
					ВидСоединения = "--";
				КонецЕсли;
				
				ЧастиТекста.Добавить(
					СоединениеТаблиц(ИмяТаблицыСоеднинения, ИмяТаблицыИсточникаОбъект, ВидСоединения));
				СписокТаблицСвязями.Добавить(ИмяТаблицыСоеднинения);
				
				Для Каждого ТекТаблицаВывода Из ТаблицыВыводаПакета Цикл
					Если ИмяТаблицыИсточникаОбъект = ТекТаблицаВывода Тогда
						Продолжить;
					КонецЕсли;
					ЧастиТекста.Добавить(
						СоединениеТаблицСкрыть(ТекТаблицаВывода, ИмяТаблицыСоеднинения));
					Прервать;
				КонецЦикла;

				Если СписокТаблиц.НайтиСтроки(
					Новый Структура("Имя,ЭтоВременнаяТаблица", ИмяТаблицыСоеднинения, Истина)).Количество() > 0
				Тогда
					ИспользуемыеВременныеТаблицы.Добавить(ИмяТаблицыСоеднинения);
				КонецЕсли;

			КонецЦикла;
			
			Если СписокСоединенийИсточника.Количество() > 0
				И ЭтотОбъект.ВыводитьУсловияСоединения Тогда
				ПредыдущаяСвязь = СписокСоединенийИсточника[СписокСоединенийИсточника.Количество() - 1];
				ЧастиТекста.Вставить(
					ПредыдущаяСвязь.НомерСтроки,
					ОписаниеУсловияСвязи(ПредыдущаяСвязь.Условие));
			КонецЕсли;
			
			ЭтоТаблицаИсточник = СписокПсевдонимов.Найти(ИсточникДанных.Источник.Псевдоним) = Неопределено;
			
			Если Не ПустаяСтрока(ПредыдущийИсточникТаблицы) И ЭтоТаблицаИсточник Тогда
				ЧастиТекста.Добавить(
					СоединениеТаблиц(
						ПредыдущийИсточникТаблицы, ИмяТаблицыИсточникаОбъект, СписокСоединений.Получить(ТипСоединенияСхемыЗапроса.Внутреннее)));
				ИсточникБезСоединения = "";
			КонецЕсли;
			
			Если ЭтоТаблицаИсточник Тогда
				ПредыдущийИсточникТаблицы = ИмяТаблицыИсточникаОбъект;
			КонецЕсли;
			
		КонецЦикла;

		Если ГруппироватьОбъединения Тогда
			Если Оператор.Источники.Количество() = 0 Тогда
				ИдентификаторКласса = Новый УникальныйИдентификатор();
				ЧастиТекста.Добавить(СтрШаблон("class %1", ИдентификаторКласса));
				ЧастиТекста.Добавить(СтрШаблон("hide %1", ИдентификаторКласса));
			КонецЕсли;
			Если СтрНачинаетсяС(ЧастиТекста[ЧастиТекста.ВГраница()], "package ") Тогда
				ЧастиТекста.Удалить(ЧастиТекста.ВГраница());
				СписокОбъединений.Удалить(СписокОбъединений[СписокОбъединений.Количество() - 1]);
				Продолжить;
			КонецЕсли;
			ЧастиТекста.Добавить("}");
		КонецЕсли;

	КонецЦикла;
	
	Если СоздаватьГруппу Тогда
		
		Если СтрЗаканчиваетсяНа(ЧастиТекста[ЧастиТекста.Вграница()], "{") Тогда
			ИдентификаторКласса = Новый УникальныйИдентификатор();
			ЧастиТекста.Добавить(СтрШаблон("class %1", ИдентификаторКласса));
			ЧастиТекста.Добавить(СтрШаблон("hide %1", ИдентификаторКласса));
		КонецЕсли;
		
		Если ЭтоДобавление Тогда
			ВидСоединения = СписокСоединений.Получить(ТипСоединенияСхемыЗапроса.ЛевоеВнешнее);
			ЧастиТекста.Добавить(
				СоединениеТаблиц(НазваниеГруппы, ПакетЗапроса.ТаблицаДляДобавления, ВидСоединения));
		КонецЕсли;
		
		ЧастиТекста.Добавить("}");
	КонецЕсли;

КонецПроцедуры

Функция ОписаниеУсловияСвязи(УсловиеСоединения)
	
	Если ПустаяСтрока(УсловиеСоединения) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СтрШаблон("note right on link #white: %1", УсловиеСоединения);
	
КонецФункции

Процедура ДобавитьСвязьСВременнойТаблицей(ЧастиТекста, СписокТаблиц, ИмяТаблицыИсточникаОбъект, ИмяТаблицы)
	
	НайденныеСтроки = СписокТаблиц.НайтиСтроки(Новый Структура("Имя, ЭтоВременнаяТаблица", ИмяТаблицы, Истина));
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЧастиТекста.Добавить(СоединениеТаблицПакета(СтрШаблон("""%1""", ИмяТаблицы), ИмяТаблицыИсточникаОбъект));
	
КонецПроцедуры

Функция  ИницализацияВложенногоЗапроса(
		ЧастиТекста, СписокТаблиц, ИсточникДанных, ИспользуемыеВременныеТаблицы, ИменаТаблиц, ПакетЗапроса)
	
	Если ИменаТаблиц.Получить(ИсточникДанных.Источник.Псевдоним) <> Неопределено Тогда
		НаименованиеТаблицы = ИменаТаблиц.Получить(ИсточникДанных.Источник.Псевдоним);
	Иначе
		НаименованиеТаблицы = ИсточникДанных.Источник.Псевдоним;
	КонецЕсли;
	
	НайденныеВложенныеТаблицы = СписокТаблиц.НайтиСтроки(Новый Структура("Имя", ИсточникДанных.Источник.Псевдоним));
	Если НайденныеВложенныеТаблицы.Количество() > 0 Тогда
		Если НайденныеВложенныеТаблицы[0].ПакетЗапроса = ПакетЗапроса Тогда
			Возврат СтрШаблон("%1%2", ИсточникДанных.Источник.Псевдоним, СтрЗаменить(ПакетЗапроса, " ", ""));
		КонецЕсли;
		НайденныеВложенныеТаблицы[0].ПакетЗапроса = ПакетЗапроса;
		
	Иначе
		
		НоваяСтрока = СписокТаблиц.Добавить();
		НоваяСтрока.Имя = ИсточникДанных.Источник.Псевдоним;
		НоваяСтрока.Номер = 0;
		НоваяСтрока.ЭтоВременнаяТаблица = Истина;
		НоваяСтрока.ПакетЗапроса = ПакетЗапроса;
		
	КонецЕсли;
	
	ЧастиНаименования = СтрРазделить(НаименованиеТаблицы, ".");
	ПредставлениеОтбора = "Отбор";
	Если ЧастиНаименования.Количество() > 1
		И ЧастиНаименования[ЧастиНаименования.ВГраница()] = ПредставлениеОтбора Тогда
		НаименованиеТаблицы = ПредставлениеОтбора;
	КонецЕсли;
	
	ИдентификаторВложенного = СтрШаблон("%1%2", ИсточникДанных.Источник.Псевдоним, СтрЗаменить(ПакетЗапроса, " ", ""));
	
	СозданиеНовойГруппыПоТекстуЗапроса1С(
			ЧастиТекста,
			ИсточникДанных.Источник.Запрос,
			ИдентификаторВложенного,
			СписокТаблиц,
			Истина,
			ИспользуемыеВременныеТаблицы,
			ИменаТаблиц,
			НаименованиеТаблицы);
	Возврат ИдентификаторВложенного;

КонецФункции

Функция ИмяТаблицыИсточникаДанныхЗапроса(ИмяТаблицыИсточника, СписокТаблиц)
	
	СтрокиТаблиц = СписокТаблиц.НайтиСтроки(Новый Структура("Имя", ИмяТаблицыИсточника));

	Если СтрокиТаблиц.Количество() = 0 Тогда
	
		СтрокаТаблицы = СписокТаблиц.Добавить();
		СтрокаТаблицы.Имя = ИмяТаблицыИсточника;
		СтрокаТаблицы.Номер = 0;
		СтрокаТаблицы.ЭтоВременнаяТаблица = Ложь;

	Иначе

		СтрокаТаблицы = СтрокиТаблиц[0];

	КонецЕсли;
	
	ИмяТаблицыДанных = СтрШаблон("%1%2", ИмяТаблицыЗапросаПредставления(СтрокаТаблицы.Имя), СтрокаТаблицы.Номер);

	Возврат ИмяТаблицыДанных;

КонецФункции

