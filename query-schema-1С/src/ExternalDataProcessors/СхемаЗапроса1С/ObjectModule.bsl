		Возврат СтрШаблон("class ""%1"" as %2 #FFFACD", "\n" + НаименованиеТаблицы + "\n", ИмяТаблицы);
	Иначе
		Возврат СтрШаблон("class ""%1"" as %2", "\n" + НаименованиеТаблицы + "\n", ИмяТаблицы);
	КонецЕсли;
