#Область ПостроениеPlantUML_ЗапросSQL

Функция Сформировать_ТекстPlantUML_СхемаЗапросаSQL(СхемаЗапроса) Экспорт
	
	Если ТипЗнч(СхемаЗапроса) = Тип("Массив") Тогда
		Если СхемаЗапроса.Количество() = 0 Тогда
			Возврат "";
		КонецЕсли;
		СхемаЗапроса = СхемаЗапроса[0];
	КонецЕсли;
	
	ПакетыЗапроса = СхемаЗапроса.Получить("tables");
	Если ПакетыЗапроса = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	СоздаватьГруппы = ПакетыЗапроса.Количество() > 1;
	ЧастиТекста = Новый Массив;
	ЧастиТекста.Добавить("@startuml");
	ЧастиТекста.Добавить(ПараметрыТекстаPlantUML());
	Если ЭтотОбъект.КомпактныйРежим Тогда
		ЧастиТекста.Добавить("together{");
	КонецЕсли;

	Для Каждого ПакетЗапроса Из ПакетыЗапроса Цикл

		СозданиеНовойГруппыПоТекстуЗапросаJSON(
			ЧастиТекста,
			ПакетЗапроса,
			СоздаватьГруппы,
			Истина);

	КонецЦикла;
	
	СвязиТаблиц = СхемаЗапроса.Получить("relations");
	ДополнитьСвязямиТекстЗапросаSQL(ЧастиТекста, СвязиТаблиц);
	
	Если ЭтотОбъект.КомпактныйРежим Тогда
		ЧастиТекста.Добавить("}");
	КонецЕсли;
	ЧастиТекста.Добавить("@enduml");
	
	Возврат СтрСоединить(ЧастиТекста, Символы.ПС);
	
КонецФункции // Сформировать_ТекстPlantUML_СхемаЗапросаSQL()

Процедура СозданиеНовойГруппыПоТекстуЗапросаJSON(
		ЧастиТекста,
		ПакетЗапроса,
		СоздаватьГруппу = Истина,
		ПервыйУровень = Ложь)

	ЭтоВременнаяТаблица = ВРег(ПакетЗапроса.Получить("type")) = ТипВременнойТаблицыJSON();
	ЭтоВложенныйЗапрос = ВРег(ПакетЗапроса.Получить("type")) = ТипВложенногоЗапросаJSON();
	ЭтоИсточникДанных = ВРег(ПакетЗапроса.Получить("type")) = ТипИсточникаДанныхJSON();
	ЭтоОбъединить = ВРег(ПакетЗапроса.Получить("type")) = ТипОбъедитьJSON();
	ЭтоОбъединитьВсе = ВРег(ПакетЗапроса.Получить("type")) = ТипОбъедитьВсеJSON()
		ИЛИ ВРег(ПакетЗапроса.Получить("type")) = ТипОбъедитьВсе2JSON();
	ЭтоЗапрос = ВРег(ПакетЗапроса.Получить("type")) = ТипВыборкиJSON();
	ЭтоГруппа = Ложь;
	
	Если ПервыйУровень Тогда
		Если ЭтоВременнаяТаблица Тогда
			ЧастиТекста.Добавить(
				СтрШаблон("package ""%1"" as %2 <<Frame>> #White {",
				ПакетЗапроса.Получить("name"),
				ПакетЗапроса.Получить("id")));
			ЭтоГруппа = Истина;
		ИначеЕсли СоздаватьГруппу Тогда
			ЧастиТекста.Добавить(
			СтрШаблон("package ""%1"" as %2 <<Frame>> #e9e8e4 {",
				ПакетЗапроса.Получить("name"),
				ПакетЗапроса.Получить("id")));
			ЭтоГруппа = Истина;
		КонецЕсли;
	ИначеЕсли ЭтоВременнаяТаблица ИЛИ ЭтоВложенныйЗапрос Тогда
		ЧастиТекста.Добавить(
			СтрШаблон("package ""%1"" as %2 <<Frame>> #White {",
			ПакетЗапроса.Получить("name"),
			ПакетЗапроса.Получить("id")));
		ЭтоГруппа = Истина;
	ИначеЕсли ЭтоОбъединить ИЛИ ЭтоОбъединитьВсе Тогда
		ЧастиТекста.Добавить(
			СтрШаблон("package ""%1"" as %2 <<<Rectangle>> #White {",
			ПакетЗапроса.Получить("name"),
			ПакетЗапроса.Получить("id")));
		ЭтоГруппа = Истина;
	ИначеЕсли ЭтоИсточникДанных Тогда
		ЧастиТекста.Добавить(СтрШаблон("class ""%1"" as %2 #FFFACD",
			"\n" + ПакетЗапроса.Получить("name") + "\n", ПакетЗапроса.Получить("id")));
	Иначе
		ЧастиТекста.Добавить(СтрШаблон("class ""%1"" as %2",
			"\n" + ПакетЗапроса.Получить("name") + "\n", ПакетЗапроса.Получить("id")));
	КонецЕсли;

	ТаблицыПакетаЗапроса = ПакетЗапроса.Получить("tables");
	Для Каждого ТаблицаПакета Из ТаблицыПакетаЗапроса Цикл
	
		СозданиеНовойГруппыПоТекстуЗапросаJSON(
			ЧастиТекста,
			ТаблицаПакета);
	
	КонецЦикла;
	
	Если ЭтоГруппа Тогда
		
		Если ТаблицыПакетаЗапроса.Количество() = 0 Тогда
			ИдентификаторКласса = Новый УникальныйИдентификатор();
			ЧастиТекста.Добавить(СтрШаблон("class %1", ИдентификаторКласса));
			ЧастиТекста.Добавить(СтрШаблон("hide %1", ИдентификаторКласса));
		КонецЕсли;
		
		ЧастиТекста.Добавить("}");
	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьСвязямиТекстЗапросаSQL(ЧастиТекста, Связи)
	
	Если Связи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СвязьМеждуВременнойТаблицей = СвязьВременнойТаблицыSQL();
	СписокСоединений = ВидыСоединенияЗапросаSQL();
	
	Для Каждого Связь Из Связи Цикл
		
		ВидСвязи = ВРег(Связь.Получить("type"));
		
		Если ВидСвязи = СвязьМеждуВременнойТаблицей Тогда
			ЧастиТекста.Добавить(СоединениеТаблицПакета(
				Связь.Получить("target_id"), Связь.Получить("source_id")));
		Иначе
			ВидСоединения = СписокСоединений.Получить(ВидСвязи);
			ЧастиТекста.Добавить(
				СоединениеТаблиц(
					Связь.Получить("source_id"),
					Связь.Получить("target_id"),
					ВидСоединения));
			Если ЭтотОбъект.ВыводитьУсловияСоединения Тогда
				ЧастиТекста.Добавить(ОписаниеУсловияСвязи(Связь.Получить("sql")));
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СвязьВременнойТаблицыSQL()
	
	Возврат "SELECT";
	
