			Результат = СформироватьУзелПакета(ТекущийУзел, МассивРебра, МассивУзлы, X, Y, КоординатыУзлов, ИдентификаторПакета, НастройкиОтображенияУзловИРебер, ИменаВременныхТаблиц, МассивИдентификаторовРебер, ЭтоУзелВременнойТаблицы, ИскатьУзелВыборки,ЭтоФинальныйУзелВыборки);

			//НастройкиОтображенияУзла = Новый Структура;
			//ДобавитьУзел(МассивУзлы, ТекущийПакет["id"], ТекущийПакет["id"], X, Y, НастройкиОтображенияУзла);
            //Продолжить;
			
		Иначе
			ИдентификаторПакета = "";
			Для ИндексУзла = 0 По ТекущийПакет.ВГраница() Цикл
				ТекущийУзел = ТекущийПакет[ИндексУзла];
				ИсходныйИдентификаторУзла = ТекущийУзел["id"];
	            ДобавлятьИдентификаторПакета = Истина;
				ЭтоУзелВременнойТаблицы = Ложь;
				ЭтоФинальныйУзелВыборки = Ложь;
		
				ИдентификаторУзла = Неопределено;
                Результат = СформироватьУзелПакета(ТекущийУзел, МассивРебра, МассивУзлы, X, Y, КоординатыУзлов, ИдентификаторПакета, НастройкиОтображенияУзловИРебер, ИменаВременныхТаблиц, МассивИдентификаторовРебер,  ЭтоУзелВременнойТаблицы, ИскатьУзелВыборки, ЭтоФинальныйУзелВыборки);

				Если Результат = Неопределено Тогда
					Продолжить;				
				КонецЕсли;
				МассивВходящихИдентификаторов 	= Результат.МассивВходящихИдентификаторов;
				ИдентификаторУзла 				= Результат.ИдентификаторУзла;
								
				Если ЭтотОбъект.Кластеризовать И МассивВходящихИдентификаторов.Количество() Тогда
					ИмяУзла = ТекущийУзел["name"];
					ИдентификаторКластера 	= СтрШаблон("cluster_%1",ИдентификаторУзла);
					ЗаголовокКластера 		= ?(ЭтоУзелВременнойТаблицы, СтрШаблон("Временная таблица: \n ""%1""",ИмяУзла),ИмяУзла);
					ЗаголовокРебраКластера 	= ?(ЭтоУзелВременнойТаблицы, "","Вложенный запрос");
					
					СтруктураКластера = Новый Структура("Идентификатор, ВходящиеИдентификаторы, Заголовок, ЗаголовокРебра", 
						ИдентификаторКластера, МассивВходящихИдентификаторов, ЗаголовокКластера, ЗаголовокРебраКластера);
					
					Для каждого ИдентификаторВходящегоУзла Из МассивВходящихИдентификаторов Цикл
						СоответствиеУзловКластерам.Вставить(ИдентификаторВходящегоУзла, ИдентификаторКластера);					
					КонецЦикла;
					МассивВходящихИдентификаторов.Добавить(ИдентификаторУзла);
					
					СоответствиеКластеров.Вставить(ИдентификаторКластера, СтруктураКластера);				
					
					ИдентификаторИсходящегоКластера = СоответствиеУзловКластерам[ИдентификаторУзла];
					Если ИдентификаторИсходящегоКластера <> Неопределено Тогда
						НастройкиИсходящегоКластера = СоответствиеКластеров[ИдентификаторИсходящегоКластера];
						ИндексВходящегоУзла = НастройкиИсходящегоКластера.ВходящиеИдентификаторы.Найти(ИдентификаторУзла);
						НастройкиИсходящегоКластера.ВходящиеИдентификаторы[ИндексВходящегоУзла] = ИдентификаторКластера;					
					КонецЕсли;					
									
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		Для каждого КлючЗначение Из СоответствиеКластеров Цикл 	
			СтруктураКластера = КлючЗначение.Значение;
			//СтруктураКластера.Вставить("X", X);
			СтруктураКластера.Вставить("Y", Y);
			МассивКластеры.Добавить(СтруктураКластера);
		КонецЦикла;
	
	КонецЦикла;
	                          
	
	
	//СтруктураКластера = Новый Структура("Идентификатор, ВходящиеИдентификаторы, Заголовок, ЗаголовокРебра", ИдентификаторКластера, МассивВходящихИдентификаторов, ЗаголовокКластера, ЗаголовокРебраКластера);
	
	//НастройкиКластера.Вставить(
	
	//clusterNodes('cluster_UNION_T3_T5', ['SELECT_T3_T4','SELECT_T5_T6','UNION_T3_T5'], '\n\n\nОбъединение\n2 пакета', 15, 'Вложенный запрос', 5);	
	//clusterNodes('cluster_SELECT_T2', ['cluster_UNION_T3_T5','SELECT_T2'], '\n\n\nSELECT_T2', 15, 'Вложенный запрос', 5);	
	////clusterNodes('cluster_Monitoring62', ['CREATE_Monitoring62','INSERT_Monitoring62', 'SELECT_T1','SELECT_T2','UNION_T3_T5','SELECT_T3_T4','SELECT_T5_T6'], 'Временная таблица Monitoring62', 15, '', 5);	
	//clusterNodes('cluster_Monitoring62', ['CREATE_Monitoring62','INSERT_Monitoring62', 'SELECT_T1','cluster_SELECT_T2'], '\n\n\n\nВременная таблица \nMonitoring62\n6 узлов', 25, '', 5);	

	//ШаблонКластера = "clusterNodes('%1', [%2], '%3', %4, '%5', %6);	";
	//ТекстКластера = СтрШаблон(ШаблонКластера,ИдентификаторКластера,ТекстВходящихИдентификаторов, ЗаголовокКластера, РазмерШрифта, ЗаголовокРебраКластера, ТолщинаРебра);
	
	
	СтруктураНастроекВизуализации = Новый Структура;
