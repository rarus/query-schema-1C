	//	|			{color: '#000000',
	//	|			highlight: 'BLUE'
	//	|			},
	//	|		font: {align: 'bottom', size: 20},
	//	|		}";
		
	Для каждого Ребро Из Ребра Цикл
	    		
		Имя 		= СтрЗаменить(Ребро.Имя, Символы.ПС, "\n");
		
		МассивСвойстваРебра = Новый Массив;
		
		МассивСвойстваРебра.Добавить(СтрШаблон(ШаблонОсновныеСвойстваРебра, Ребро.Идентификатор, Имя, Ребро.ИдентификаторНачало, Ребро.ИдентификаторКонец,  Ребро.НавигационнаяСсылка));

		Если ЗначениеЗаполнено(Ребро.Заголовок) Тогда
			МассивСвойстваРебра.Добавить(СтрШаблон("""title"": ""<pre>%1<pre>""", ОбработатьСтрокуДляHTML(Ребро.Заголовок)));
