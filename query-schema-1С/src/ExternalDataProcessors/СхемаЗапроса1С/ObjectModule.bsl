Функция ВидыСоединенияЗапросаSQL()
	
	НаправлениеСвязей = "up";
	
	ВидыСоединений = Новый Соответствие();
	ВидыСоединений.Вставить("INNER_JOIN", СтрШаблон("o-%1[dashed]-o", НаправлениеСвязей));
	ВидыСоединений.Вставить("LEFT_JOIN", СтрШаблон("o-%1[dashed]-*", НаправлениеСвязей));
	ВидыСоединений.Вставить("FULL_JOIN", СтрШаблон("*-%1[dashed]-*", НаправлениеСвязей));
	ВидыСоединений.Вставить("RIGHT_JOIN", СтрШаблон("*-%1[dashed]-o", НаправлениеСвязей));
	ВидыСоединений.Вставить("CORRELATED_SUBQUERY", СтрШаблон("o-%1[dashed]-o", НаправлениеСвязей));
	ВидыСоединений.Вставить("LEFT_OUTER_JOIN", СтрШаблон("o-%1[dashed]-*", НаправлениеСвязей));
	
	Возврат ВидыСоединений;
	
