// Возвращает сведения о внешней обработке.
//
// Возвращаемое значение:
//   Структура - сведения о внешней обработке.
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ОбъектМетаданных = ЭтотОбъект.Метаданные();
	
	ПараметрыРегистрации = Новый Структура;
	
	ПараметрыРегистрации.Вставить("Вид",          "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Версия",       "1.0.1.1");
	ПараметрыРегистрации.Вставить("Назначение",   Новый Массив);
	ПараметрыРегистрации.Вставить("Наименование", ОбъектМетаданных.Синоним);
	ПараметрыРегистрации.Вставить("Информация",   ОбъектМетаданных.Комментарий);
	ПараметрыРегистрации.Вставить("ВерсияБСП",    "3.1.5.110");
	
	ПараметрыРегистрации.Вставить("БезопасныйРежим",          Ложь);
	ПараметрыРегистрации.Вставить("ОпределитьНастройкиФормы", Ложь);
	
	ТаблицаКоманд = Новый ТаблицаЗначений;
	ТаблицаКоманд.Колонки.Добавить("Представление",        Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Идентификатор",        Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Использование",        Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	ТаблицаКоманд.Колонки.Добавить("Модификатор",          Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Скрыть",               Новый ОписаниеТипов("Булево"));
	ТаблицаКоманд.Колонки.Добавить("ЗаменяемыеКоманды",    Новый ОписаниеТипов("Строка"));
	
	Команда = ТаблицаКоманд.Добавить();
	Команда.Представление = ОбъектМетаданных.Синоним;
	Команда.Использование = "ОткрытиеФормы";
	Команда.Идентификатор = ОбъектМетаданных.Имя;
	
	ПараметрыРегистрации.Вставить("Команды",    ТаблицаКоманд);
	ПараметрыРегистрации.Вставить("Разрешения", Новый Массив);
	
	ПараметрыРегистрации.Вставить("Авторы", НСтр("ru = 'Станислав Борисенко; Евгений Виноградов; Данил Кутов; Андрей Черанев; Дмитрий Чесноков; Антон Цюпцюн'"));
	ПараметрыРегистрации.Вставить("РепозиторийПроекта", "https://github.com/rarus/query-schema-1С");
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область КорректировкаТекстаЗапроса1С

Функция ПолучитьСхемуЗапроса1С(ТекстЗапроса, ИзмененныйЗапрос, ИменаТаблиц) Экспорт
	
	СхемаЗапроса = Новый СхемаЗапроса;
	ИменаТаблиц  = Новый Соответствие();
	
	// Пробуем прочитать запрос как есть
	Попытка
		СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
		ИзмененныйЗапрос = "";
		Возврат СхемаЗапроса;
	Исключение
		Причина = ИнформацияОбОшибке();
	КонецПопытки;
	
	// Производим подмену в запросе обращений к таблицам БД
	ИзмененныйЗапрос = КорректировкаТекстаЗапроса1С(ТекстЗапроса, ИменаТаблиц);
	
	Попытка
		СхемаЗапроса.УстановитьТекстЗапроса(ИзмененныйЗапрос);
	Исключение
		
		Причина = ИнформацияОбОшибке();
		
		ВызватьИсключение СтрШаблон(НСтр("ru = 'При разборе текста запроса возникла ошибка: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(Причина));
		
	КонецПопытки;
	
	Возврат СхемаЗапроса;
	
КонецФункции // ПолучитьСхемуЗапроса1С()

Функция КорректировкаТекстаЗапроса1С(Знач ТекстЗапроса, ИменаТаблиц=Неопределено, ВремяРаботы=0)
	
	// Важно! Если не задан пресвдоним таблиц, но есть обращение к полям, то такой запрос не будет читаться схемой
	
	//Ошибки:
	// - Декартово произведение
	//   * Как отличить поле от таблицы: Документ.Ссылка
	//   + Константы прощены
	
	ВремяНачало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ИзмененныйЗапрос = ТекстЗапроса;
	
	Если ИменаТаблиц=Неопределено Тогда
		ИменаТаблиц = Новый Соответствие();
	КонецЕсли;
	
	ШаблоныЗаменыЗапроса = Новый СписокЗначений();
	
	// Все строковые выражения в запросе заменяем на пустую строку
	ШаблоныЗаменыЗапроса.Добавить(СтрЗаменить("(?<!')'(?:[^']|'')++'", "'", """"), """""");
	
	// Убираем все комментарии из текста запроса
	ШаблоныЗаменыЗапроса.Добавить("\/\/.*$", "");
	
	// Исключаем директивы компоновщика данных
	//!!!ШаблоныЗаменыЗапроса.Добавить("\{[^{}]*\}", "");
	
	// Производим подмену операторов ССЫЛКА
	ШаблоныЗаменыЗапроса.Добавить("\b(?:ССЫЛКА|REF)\s+[A-ZА-Я0-9_]+(?:\.[A-ZА-Я0-9_]+)+", "ЕСТЬ NULL");
	
	// Производим замену вызова функции ТИП
	ШаблоныЗаменыЗапроса.Добавить("\b(?:ТИП)\s*\(\s*[A-ZА-Я0-9_]+(?:\.[A-ZА-Я0-9_]+)+\s*\)", "&__EXT__TYPE__");
	
	// Производим подмену всех операторов ЗНАЧЕНИЕ
	ШаблоныЗаменыЗапроса.Добавить("\b(?:ЗНАЧЕНИЕ|VALUE)\s*\([^()]*\)", "&__EXT__VALUE__");
	
	// Производим простую подмену опаратора ВЫРАЗИТЬ, которые обращаются к таблицам БД
	ШаблоныЗаменыЗапроса.Добавить("\b(?:ВЫРАЗИТЬ|CAST)++\s*\([^()]*\s+(?:КАК|AS)\s+[A-ZА-Я0-9_]+(?:\.[A-ZА-Я0-9_]+)+\s*\)", "&__EXT__CAST_A__");
	
	// Производим рекурсивную замену операторов ВЫРАЗИТь со вложениями
	ШаблоныЗаменыЗапроса.Добавить("\b(?:ВЫРАЗИТЬ|CAST)\s*\(.*\s+(?:КАК|AS)\s+[A-ZА-Я0-9_]+(?:\.[A-ZА-Я0-9_]+)+\s*\)", "&__EXT__CAST_B№__", ИСТИНА);
	//ШаблоныЗаменыЗапроса.Добавить("\b(?:КАК|AS)\s+[A-ZА-Я0-9_]+(?:\.[A-ZА-Я0-9_]+)+\s*(?=\))", "КАК СТРОКА(0)", ИСТИНА);
	//!!! Сделать рекурсивную замену всего первого блока ВЫРАЗИТЬ в котором встречается " КАК Имя.Таблицы)"
	
	// Поиск обращений к физическим таблицам БД
	ШаблоныЗаменыЗапроса.Добавить("\b(?<=ИЗ|FROM|СОЕДИНЕНИЕ|JOIN)\s+((?:"+ВсеКлассыТаблицБД()+")(?:\.[A-ZА-Я0-9_]+)++)(?!\s*\()", " __EXT__TABLE_№__", ИСТИНА);
	
	// Произведем подмену обращений к виртуальным таблицам с простыми параметрами
	ШаблоныЗаменыЗапроса.Добавить("\b((?:"+ВсеКлассыТаблицБД(ИСТИНА)+")(?:\.[A-ZА-Я0-9_]+)++)\s*(\([^()]*\))", "__EXT__VIRTUAL_A№__", ИСТИНА);
	
	// Производим поиск обращений к виртуальным таблицам со сложным содержимым в секции параметров
	ШаблоныЗаменыЗапроса.Добавить("\b((?:"+ВсеКлассыТаблицБД(ИСТИНА)+")(?:\.[A-ZА-Я0-9_]+)+)\s*\(", "__EXT__VIRTUAL_B№__", ИСТИНА);
	
	// Простим декартово произведение константам
	ШаблоныЗаменыЗапроса.Добавить("\b((?:КОНСТАНТА|CONSTANT)(?:\.[A-ZА-Я0-9_]+)++)(?!\s*\()", "__EXT__CONST_№__", ИСТИНА);
	
	//!!! Запрос на поиск и корректировку второй и последующих таблиц в декартовом произведении
	
	// Исправляем возникшие точки обращения к вложенным полям параметров
	ШаблоныЗаменыЗапроса.Добавить("&+[A-ZА-Я0-9_]+(?:\.[A-ZА-Я0-9_]+)+", "&__EXT__SUBPARAM__");
	
	// Финальный шаг: убираем обращения к вложенным полям таблиц более чем через 2 точки
	ШаблоныЗаменыЗапроса.Добавить("\b[A-ZА-Я0-9_]+(?:\.[A-ZА-Я0-9_]+){2,}(?:\s*\.\s*[*])?", "&__EXT__SUBFILD_A__", ИСТИНА);
	ШаблоныЗаменыЗапроса.Добавить("\b(?:[A-ZА-Я0-9_]+\.){2,}\s*\*",                         "&__EXT__SUBFILD_B__", ИСТИНА);
	
	// Выполняем последовательную корректировку текста запроса
	Для каждого Шаблон Из ШаблоныЗаменыЗапроса Цикл
		Если Шаблон.Пометка ИЛИ СтрНайти(Шаблон.Представление, "№") > 0 Тогда
			
			НачальнаяПозиция = 1;
			
			Пока ИСТИНА Цикл
				
				РезультатПоиска = СтрНайтиПоРегулярномуВыражению(ИзмененныйЗапрос, Шаблон.Значение,, НачальнаяПозиция,, ИСТИНА, ИСТИНА);
				Если РезультатПоиска.НачальнаяПозиция=0 Тогда
					Прервать;
				КонецЕсли;
				НачальнаяПозиция = РезультатПоиска.НачальнаяПозиция+1;
				
				ЕстьВложенныеБлоки = (Прав(СокрЛП(РезультатПоиска.Значение), 1)="(");
				ЕстьИмяТаблицы     = (РезультатПоиска.ПолучитьГруппы().Количество() > 0);
				
				ПредыдущийБлок  = Сред(ИзмененныйЗапрос, 1, РезультатПоиска.НачальнаяПозиция-1);
				НовыйБлок       = СтрЗаменить(Шаблон.Представление, "№", Формат(ИменаТаблиц.Количество()+1, "ЧН=0; ЧГ=0"));
				ТекущийБлок     = ?(ЕстьВложенныеБлоки, ПолучитьБлокЗапроса(ИзмененныйЗапрос, РезультатПоиска), РезультатПоиска.Значение);
				КонечнаяПозиция = РезультатПоиска.НачальнаяПозиция + СтрДлина(ТекущийБлок);
				
				ИмяТаблицы = ?(ЕстьИмяТаблицы, РезультатПоиска.ПолучитьГруппы()[0].Значение, ТекущийБлок);
				ИменаТаблиц.Вставить(СокрЛП(НовыйБлок), СокрЛП(ИмяТаблицы));
				
				Если ЕстьВложенныеБлоки И ЕстьИмяТаблицы Тогда
					БлокСоединений = ПеренестиВложенныеЗапросыКакСоединения(ИзмененныйЗапрос, ТекущийБлок, ИмяТаблицы, ИменаТаблиц);
					Если НЕ ПустаяСтрока(БлокСоединений) Тогда
						ПоискПсевдонима = СтрНайтиПоРегулярномуВыражению(ИзмененныйЗапрос, "\b(?:КАК|AS)\s+[A-ZА-Я0-9_]+",, КонечнаяПозиция,, ИСТИНА, ИСТИНА);
						Если ПустаяСтрока(Сред(ИзмененныйЗапрос, КонечнаяПозиция, ПоискПсевдонима.НачальнаяПозиция - КонечнаяПозиция)) Тогда
							НовыйБлок       = НовыйБлок + " " + ПоискПсевдонима.Значение + БлокСоединений;
							КонечнаяПозиция = ПоискПсевдонима.НачальнаяПозиция + ПоискПсевдонима.Длина;
						Иначе
							
							// Псевдоним можно синтезировать, но запрос не будет читаться схемой
							Псевдоним = СтрЗаменить(Сред(ИмяТаблицы, СтрНайти(ИмяТаблицы, ".")+1), ".", "");
							НовыйБлок       = НовыйБлок + " КАК " + Псевдоним + БлокСоединений;
							
							// Критическая ошибка: нет псевдонима у виртуальной таблицы с вложенным запросом
							//!!! ВызватьИсключение СтрШаблон(НСтр("ru = 'Виртуальная таблица %1 с вложенным запросом нет содержит псевдоним.'"), ИмяТаблицы);
							
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				ЧастиЗапроса = Новый Массив();
				ЧастиЗапроса.Добавить(ПредыдущийБлок);
				ЧастиЗапроса.Добавить(НовыйБлок);
				ЧастиЗапроса.Добавить(Сред(ИзмененныйЗапрос, КонечнаяПозиция));
				ИзмененныйЗапрос = СтрСоединить(ЧастиЗапроса);
				
			КонецЦикла;
			
			
		ИначеЕсли Шаблон.Пометка Тогда
			Пока СтрНайтиПоРегулярномуВыражению(ИзмененныйЗапрос, Шаблон.Значение, НаправлениеПоиска.СНачала, 1, 1, ИСТИНА, ИСТИНА).НачальнаяПозиция > 0 Цикл
				ИзмененныйЗапрос = СтрЗаменитьПоРегулярномуВыражению(ИзмененныйЗапрос, Шаблон.Значение, Шаблон.Представление, ИСТИНА, ИСТИНА);
			КонецЦикла;
			
		Иначе
			ИзмененныйЗапрос = СтрЗаменитьПоРегулярномуВыражению(ИзмененныйЗапрос, Шаблон.Значение, Шаблон.Представление, ИСТИНА, ИСТИНА);
		КонецЕсли;
	КонецЦикла;
	
	ВремяРаботы = ТекущаяУниверсальнаяДатаВМиллисекундах()-ВремяНачало;
	
	Возврат ИзмененныйЗапрос;
	
КонецФункции // КорректировкаТекстаЗапроса1С()

