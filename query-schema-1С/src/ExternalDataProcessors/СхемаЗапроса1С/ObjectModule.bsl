#Область ВызовСервисаPlantUML

Функция СформироватьДиаграммуНаСервисеPlantUML(ТекстPlantUML) Экспорт
	
	Если ПустаяСтрока(ТекстPlantUML) Тогда
		Возврат "";
	КонецЕсли;
	
	// На сервере PlantUML должны быть резрешены POST запросы и увеличены лимиты
	СерверPlantUML = "plantuml.rarus.ru";
	
	Попытка
		Если БезопасныйРежим() Тогда
			УстановитьБезопасныйРежим(ЛОЖЬ);
		КонецЕсли;
	Исключение
		ТекстСообщения = НСтр("ru = 'Установлен безопасный режим. Вызов внешнего сервиса PlantUML заблокирован. Используйте режим VIS.JS.'");
		ВызватьИсключение ТекстСообщения;
	КонецПопытки;
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=utf-8");
	
	Запрос = Новый HTTPЗапрос("/plantuml/svg/", Заголовки);
	Запрос.УстановитьТелоИзСтроки(ТекстPlantUML, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Соединение = Новый HTTPСоединение(СерверPlantUML, 80,,,, 600);
	
	Попытка
		
		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		
	Исключение
		
		ТекстСообщения = СтрШаблон(НСтр("ru = 'При формировании изображения диаграммы на сервере %1 возникала ошибка:%2%3'"),
			СерверPlantUML,
			Символы.ПС,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстСообщения;
		
	КонецПопытки;

	Если Ответ.КодСостояния < 200 ИЛИ Ответ.КодСостояния > 299 Тогда

		ТекстСообщения = СтрШаблон(НСтр("ru = 'При формировании изображения диаграммы на сервере %1 возникала ошибка:%2%3'"),
			СерверPlantUML,
			Символы.ПС,
			Ответ.ПолучитьТелоКакСтроку());
		ВызватьИсключение ТекстСообщения;

	КонецЕсли;
	
	// Кодировка берется из заголовков ответа, но если будут сбои, то использовать КодировкаТекста.UTF8
	Возврат Ответ.ПолучитьТелоКакСтроку();

КонецФункции // СформироватьДиаграммуНаСервисеPlantUML()

#КонецОбласти

#Область ПостроениеJSON_Запрос1С

Функция Сформировать_СхемаЗапросаVIS_СхемаЗапроса1С(СхемаЗапроса, ИменаТаблиц) Экспорт
	
	ДанныеСхемыЗапроса = ТаблицыПакетовЗапроса(СхемаЗапроса, ИменаТаблиц);
	
	СхемаЗапросаVIS = ЗаполнитьJSONДляЗапроса(ДанныеСхемыЗапроса);
	
	Возврат СхемаЗапросаVIS;
	
КонецФункции // Сформировать_СхемаЗапросаVIS_СхемаЗапроса1С()

Функция ТаблицыПакетовЗапроса(СхемаЗапроса, ИменаТаблиц)
	
	НомерЗапроса = 0;
	ВременныеТаблицы = Новый Соответствие();
	ЭлементыСхемыЗапроса = Новый ДеревоЗначений();
	ЭлементыСхемыЗапроса.Колонки.Добавить("Идентификатор");
	ЭлементыСхемыЗапроса.Колонки.Добавить("Представление");
	ЭлементыСхемыЗапроса.Колонки.Добавить("Тип");
	ЭлементыСхемыЗапроса.Колонки.Добавить("ТекстЗапроса");
	
	СоедниненияТаблиц = Новый ТаблицаЗначений();
	СоедниненияТаблиц.Колонки.Добавить("Группа");
	СоедниненияТаблиц.Колонки.Добавить("Источник");
	СоедниненияТаблиц.Колонки.Добавить("Приемник");
	СоедниненияТаблиц.Колонки.Добавить("ТипСоединения");
	СоедниненияТаблиц.Колонки.Добавить("ПсевдонимТаблицы");
	СоедниненияТаблиц.Колонки.Добавить("Условие");
	
	Для Каждого ПакетЗапроса Из СхемаЗапроса.ПакетЗапросов Цикл

		ИспользуемыеВременныеТаблицы = Новый Массив();
		НомерЗапроса = НомерЗапроса + 1;

		Если ТипЗнч(ПакетЗапроса) = Тип("ЗапросУничтоженияТаблицыСхемыЗапроса") Тогда

			ИдентификаторУдаляемойТаблицы = ВременныеТаблицы.Получить(ПакетЗапроса.ИмяТаблицы);
			Если ИдентификаторУдаляемойТаблицы <> Неопределено Тогда
				ГруппаРодитель = ЭлементыСхемыЗапроса.Строки.Добавить();
				ГруппаРодитель.Идентификатор = ИдентификаторУдаляемойТаблицы;
				ГруппаРодитель.Представление = ПакетЗапроса.ИмяТаблицы;
				ГруппаРодитель.Тип = "DROP";
			КонецЕсли;
			
			Продолжить;

		КонецЕсли;

		Если ПустаяСтрока(ПакетЗапроса.ТаблицаДляПомещения) Тогда

			НоваяГруппа = ЭлементыСхемыЗапроса.Строки.Добавить();
			НоваяГруппа.Идентификатор = Строка(Новый УникальныйИдентификатор());
			НоваяГруппа.Представление = СтрШаблон("ПакетЗапроса%1", Формат(НомерЗапроса, "ЧГ=;"));
			НоваяГруппа.Тип = "SELECT";
			НоваяГруппа.ТекстЗапроса = СформироватьТекстЗапроса(
				ПакетЗапроса.ПолучитьТекстЗапроса(),
				ИменаТаблиц);

		Иначе

			НоваяГруппа = ЭлементыСхемыЗапроса.Строки.Добавить();
			НоваяГруппа.Идентификатор = Строка(Новый УникальныйИдентификатор());
			НоваяГруппа.Представление = ПакетЗапроса.ТаблицаДляПомещения;
			НоваяГруппа.Тип = "INSERT";
			ВременныеТаблицы.Вставить(ПакетЗапроса.ТаблицаДляПомещения, НоваяГруппа.Идентификатор);
			НоваяГруппа.ТекстЗапроса = СформироватьТекстЗапроса(
				ПакетЗапроса.ПолучитьТекстЗапроса(),
				ИменаТаблиц);

		КонецЕсли;
		
		СозданиеНовойГруппыПоТекстуЗапроса(
			НоваяГруппа,
			ПакетЗапроса,
			ИменаТаблиц,
			ВременныеТаблицы,
			СоедниненияТаблиц);

	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("ЭлементыСхемыЗапроса", ЭлементыСхемыЗапроса);
	Результат.Вставить("СоедниненияТаблиц",    СоедниненияТаблиц);
	
	Возврат Результат;
	
КонецФункции

Процедура СозданиеНовойГруппыПоТекстуЗапроса(
		ГруппаЗапроса,
		ПакетЗапроса,
		ИменаТаблиц,
		ВременныеТаблицы,
		СоедниненияТаблиц)

	ГруппироватьОбъединения = ПакетЗапроса.Операторы.Количество() > 1;
	
	Если ГруппироватьОбъединения Тогда
		ГруппаОбъединения = ГруппаЗапроса.Строки.Добавить();
		ГруппаОбъединения.Идентификатор = Строка(Новый УникальныйИдентификатор());
		Если ПакетЗапроса.Операторы[1].ТипОбъединения = ТипОбъединенияСхемыЗапроса.Объединить Тогда
			ГруппаОбъединения.Представление = НСтр("ru = 'ОБЪЕДИНИТЬ'");
		Иначе
			ГруппаОбъединения.Представление = НСтр("ru = 'ОБЪЕДИНИТЬ ВСЕ'");
		КонецЕсли;
		ГруппаОбъединения.Тип = "UNION";
	КонецЕсли;
	
	СписокТаблиц = Новый Массив();
	НомерТаблицыОбъединения = 0;
	
	ИсточникБезСоединения = "";
	Для Каждого Оператор Из ПакетЗапроса.Операторы Цикл
		
		НомерТаблицыОбъединения = НомерТаблицыОбъединения + 1;
		
		СоответствиеИменТаблиц = Новый Соответствие();
		
		Если ГруппироватьОбъединения Тогда
			
			ГруппаУровня = ГруппаОбъединения.Строки.Добавить();
			ГруппаУровня.Идентификатор = Строка(Новый УникальныйИдентификатор());
			ГруппаУровня.Представление = СтрШаблон(НСтр("ru = 'ТаблицаОбъединения%1'"), Формат(НомерТаблицыОбъединения, "ЧГ=;"));
			ГруппаУровня.Тип = "SELECT";
			
		Иначе
			
			ГруппаУровня = ГруппаЗапроса;
			
		КонецЕсли;

		ПредыдущийИсточникТаблицы = "";
		СписокПсевдонимов = Новый Массив();
		Для Каждого ИсточникДанных Из Оператор.Источники Цикл

			ИдентификаторТаблицы = ИдентификаторТаблицыЗапроса(
				ИсточникДанных,
				ГруппаУровня,
				СоответствиеИменТаблиц,
				ВременныеТаблицы,
				ИменаТаблиц,
				СоедниненияТаблиц);

			Для Каждого Соединение Из ИсточникДанных.Соединения Цикл

				ИдентификаторТаблицыСоединения = ИдентификаторТаблицыЗапроса(
					Соединение.Источник,
					ГруппаУровня,
					СоответствиеИменТаблиц,
					ВременныеТаблицы,
					ИменаТаблиц,
					СоедниненияТаблиц);
				
				СписокПсевдонимов.Добавить(Соединение.Источник.Источник.Псевдоним);
				НайденныеСоединения = СоедниненияТаблиц.НайтиСтроки(
					Новый Структура("Группа,Источник,Приемник,ТипСоединения,ПсевдонимТаблицы",
					ГруппаУровня.Идентификатор, ИдентификаторТаблицы, ИдентификаторТаблицыСоединения, Соединение.ТипСоединения, Соединение.Источник.Источник.Псевдоним));
				
				Если НайденныеСоединения.Количество() > 0 Тогда
					НайденныеСоединения[0].Условие = СтрШаблон("%1%2И %3", НайденныеСоединения[0].Условие, Символы.ПС, Строка(Соединение.Условие));
					Продолжить;
				КонецЕсли;
				
				СоединениеТаблиц = СоедниненияТаблиц.Добавить();
				СоединениеТаблиц.Группа = ГруппаУровня.Идентификатор;
				СоединениеТаблиц.Источник = ИдентификаторТаблицы;
				СоединениеТаблиц.Приемник = ИдентификаторТаблицыСоединения;
				СоединениеТаблиц.ТипСоединения = Соединение.ТипСоединения;
				СоединениеТаблиц.ПсевдонимТаблицы = Соединение.Источник.Источник.Псевдоним;
				СоединениеТаблиц.Условие = Строка(Соединение.Условие);

			КонецЦикла;
			
			ЭтоТаблицаИсточник = СписокПсевдонимов.Найти(ИсточникДанных.Источник.Псевдоним) = Неопределено;
			
			Если Не ПустаяСтрока(ПредыдущийИсточникТаблицы) И ЭтоТаблицаИсточник Тогда
				СоединениеТаблиц = СоедниненияТаблиц.Добавить();
				СоединениеТаблиц.Группа = ГруппаУровня.Идентификатор;
				СоединениеТаблиц.Источник = ПредыдущийИсточникТаблицы;
				СоединениеТаблиц.Приемник = ИдентификаторТаблицы;
				СоединениеТаблиц.ТипСоединения = ТипСоединенияСхемыЗапроса.Внутреннее;
			КонецЕсли;
			
			Если ЭтоТаблицаИсточник Тогда
				ПредыдущийИсточникТаблицы = ИдентификаторТаблицы;
			КонецЕсли;
			
		КонецЦикла;

	КонецЦикла;
	
КонецПроцедуры

Функция ИдентификаторТаблицыЗапроса(
		Источник,
		ТекущаяГруппа,
		СоответствиеИменТаблиц,
		ВременныеТаблицы,
		ИменаТаблиц,
		СоедниненияТаблиц)
	
	Если ТипЗнч(Источник.Источник) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
		
		Возврат ИдентификаторВложенногоЗапроса(
			Источник.Источник,
			ТекущаяГруппа,
			ВременныеТаблицы,
			ИменаТаблиц,
			СоедниненияТаблиц,
			СоответствиеИменТаблиц);
		
	КонецЕсли;
	
	ИмяТаблицы = Источник.Источник.ИмяТаблицы;
	ИдентификаторТаблицы = СоответствиеИменТаблиц.Получить(ИмяТаблицы);
	
	Если ИдентификаторТаблицы <> Неопределено Тогда
		Возврат ИдентификаторТаблицы;
	КонецЕсли;
	
	Если СтрНайти(ИмяТаблицы, ".") = 0
		И Не СтрНачинаетсяС(ИмяТаблицы, "&")
		И ИменаТаблиц.Получить(ИмяТаблицы) <> Неопределено Тогда
		НаименованиеТаблицы = ИменаТаблиц.Получить(ИмяТаблицы);
	Иначе
		НаименованиеТаблицы = ИмяТаблицы;
	КонецЕсли;
	
	ИдентификаторВременнойТаблицы = ВременныеТаблицы.Получить(ИмяТаблицы);
	
	Если ЭтотОбъект.СворачиватьПромежуточныеУзлы Тогда
		
		Если ИдентификаторВременнойТаблицы <> Неопределено Тогда
			ТаблицаЗапроса = ТекущаяГруппа.Строки.Добавить();
			ТаблицаЗапроса.Идентификатор = ИдентификаторВременнойТаблицы;
			СоответствиеИменТаблиц.Вставить(ИмяТаблицы, ИдентификаторВременнойТаблицы);
			Возврат ИдентификаторВременнойТаблицы;
		КонецЕсли;
		
		ТаблицаЗапроса = ТекущаяГруппа.Строки.Добавить();
		ТаблицаЗапроса.Идентификатор = Строка(Новый УникальныйИдентификатор());
		ТаблицаЗапроса.Представление = НаименованиеТаблицы;
		ТаблицаЗапроса.Тип = "TABLE";
		СоответствиеИменТаблиц.Вставить(ИмяТаблицы, ТаблицаЗапроса.Идентификатор);
		
	Иначе
		
		ТаблицаЗапроса = ТекущаяГруппа.Строки.Добавить();
		ТаблицаЗапроса.Идентификатор = Строка(Новый УникальныйИдентификатор());
		ТаблицаЗапроса.Представление = НаименованиеТаблицы;
		
		ИдентификаторВременнойТаблицы = ВременныеТаблицы.Получить(ИмяТаблицы);
		Если ИдентификаторВременнойТаблицы <> Неопределено Тогда
			СтрокаВременнаяТаблица = ТаблицаЗапроса.Строки.Добавить();
			СтрокаВременнаяТаблица.Идентификатор = ИдентификаторВременнойТаблицы;
			ТаблицаЗапроса.Тип = "SELECT";
		Иначе
			ТаблицаЗапроса.Тип = "TABLE";
		КонецЕсли;
		СоответствиеИменТаблиц.Вставить(ИмяТаблицы, ТаблицаЗапроса.Идентификатор);
		
	КонецЕсли;
	
	Возврат ТаблицаЗапроса.Идентификатор;
	
КонецФункции

Функция ИдентификаторВложенногоЗапроса(
		Источник,
		ТекущаяГруппа,
		ВременныеТаблицы,
		ИменаТаблиц,
		СоедниненияТаблиц,
		СоответствиеИменТаблиц)
	
	НайденныйИдентификатор = СоответствиеИменТаблиц.Получить(Источник.Псевдоним);
	Если НайденныйИдентификатор <> Неопределено Тогда
		Возврат НайденныйИдентификатор;
	КонецЕсли;
	ИмяТаблицы = ИменаТаблиц.Получить(Источник.Псевдоним);
	Если ИмяТаблицы = Неопределено Тогда
		ИмяТаблицы = Источник.Псевдоним;
	КонецЕсли;
	
	ЧастиНаименования = СтрРазделить(ИмяТаблицы, ".");
	ПредставлениеОтбора = "Отбор";
	Если ЧастиНаименования.Количество() > 1
		И ЧастиНаименования[ЧастиНаименования.ВГраница()] = ПредставлениеОтбора Тогда
		ИмяТаблицы = ПредставлениеОтбора;
	КонецЕсли;
	
	ВложенныйЗапрос = ТекущаяГруппа.Строки.Добавить();
	ВложенныйЗапрос.Идентификатор = Строка(Новый УникальныйИдентификатор());
	ВложенныйЗапрос.Представление = ИмяТаблицы;
	ВложенныйЗапрос.Тип = "SELECT";
	ВложенныйЗапрос.ТекстЗапроса = СформироватьТекстЗапроса(
		Источник.Запрос.ПолучитьТекстЗапроса(),
		ИменаТаблиц);
	
	СоответствиеИменТаблиц.Вставить(Источник.Псевдоним, ВложенныйЗапрос.Идентификатор);
	
	СозданиеНовойГруппыПоТекстуЗапроса(
			ВложенныйЗапрос,
			Источник.Запрос,
			ИменаТаблиц,
			ВременныеТаблицы,
			СоедниненияТаблиц);
	
	Возврат ВложенныйЗапрос.Идентификатор;

КонецФункции

Функция СформироватьТекстЗапроса(ТекстПакетаЗапроса, ИменаТаблиц)
	
	РезультатТекстаЗапроса = ТекстПакетаЗапроса;
	
	Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
		
		РезультатТекстаЗапроса = СтрЗаменить(РезультатТекстаЗапроса, ИмяТаблицы.Ключ, ИмяТаблицы.Значение);
		
	КонецЦикла;
	
	РезультатТекстаЗапроса = СтрЗаменить(РезультатТекстаЗапроса, Символы.Таб, "    ");
	
	Возврат РезультатТекстаЗапроса;
	
КонецФункции

Функция ЗаполнитьJSONДляЗапроса(ДанныеСхемыЗапроса)
	
	ДанныеJSON = Новый Массив();
	
	Для Каждого ТекущийПакетЗапроса Из ДанныеСхемыЗапроса.ЭлементыСхемыЗапроса.Строки Цикл
		
		ПакетЗапроса = Новый Массив();
		ЗаполнитьТаблицыИСвязиПакетаЗапросаJSON(ПакетЗапроса, ТекущийПакетЗапроса, ДанныеСхемыЗапроса.СоедниненияТаблиц);
		
		ДанныеJSON.Добавить(ПакетЗапроса);
		
	КонецЦикла;
	
	Возврат ДанныеJSON;
	
КонецФункции

Процедура ЗаполнитьТаблицыИСвязиПакетаЗапросаJSON(ПакетЗапроса, ЭлементЗапроса, Связи)
	
	Если ПустаяСтрока(ЭлементЗапроса.Тип)
		ИЛИ ЭлементЗапроса.Тип = "DROP" Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьТаблицуЗапроса(ПакетЗапроса, ЭлементЗапроса, Связи);
	
	Для Каждого ПодчиненныйЭлемент Из ЭлементЗапроса.Строки Цикл
		
		ЗаполнитьТаблицыИСвязиПакетаЗапросаJSON(ПакетЗапроса, ПодчиненныйЭлемент, Связи)
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьТаблицуЗапроса(ПакетЗапроса, ЭлементЗапроса, Связи)
	
	Если ПустаяСтрока(ЭлементЗапроса.Тип) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЭлемента = ШаблонЭлементаЗапроса();
	
	ПараметрыЭлемента.id = ЭлементЗапроса.Идентификатор;
	ПараметрыЭлемента.name = ЭлементЗапроса.Представление;
	ПараметрыЭлемента.type = ЭлементЗапроса.Тип;
	
	Если ЗначениеЗаполнено(ЭлементЗапроса.Родитель) Тогда
		ПараметрыЭлемента.parentid = ЭлементЗапроса.Родитель.Идентификатор;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭлементЗапроса.ТекстЗапроса) Тогда
		ПараметрыЭлемента.sql = ЭлементЗапроса.ТекстЗапроса;
	КонецЕсли;
	
	Для Каждого ПодчиненныйЭлемент Из ЭлементЗапроса.Строки Цикл
		
		ПараметрыЭлемента.relations.Добавить(ИдентификаторПодчиненногоЭлемента(ПодчиненныйЭлемент.Идентификатор));
		
	КонецЦикла;
	
	НайденныеСвязи = Связи.НайтиСтроки(Новый Структура("Группа", ЭлементЗапроса.Идентификатор));
	Для Каждого ТекущаяСтрока Из НайденныеСвязи Цикл
		
		ПараметрыСвязи = ШаблонСвязиТаблиц();
		ПараметрыСвязи.id = ТекущаяСтрока.Источник;
		ПараметрыСвязи.type = ВидыСоединенияЗапроса().Получить(ТекущаяСтрока.ТипСоединения);
		ПараметрыСвязи.on = ТекущаяСтрока.Приемник;
		ПараметрыСвязи.sql = ТекущаяСтрока.Условие;
		ПараметрыЭлемента.joins.Добавить(ПараметрыСвязи);
		
	КонецЦикла;
	
	ПакетЗапроса.Добавить(ПараметрыЭлемента);
	
КонецПроцедуры

