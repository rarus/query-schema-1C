			//	БлокировкаПоГоризонтали = НастройкиОтображенияУзла.БлокировкаПоГоризонтали;
			//КонецЕсли;
			
			Если НастройкиОтображенияУзла.Свойство("ТолщинаЛинии") Тогда
				МассивСвойстваУзла.Добавить(СтрШаблон("""borderWidth"": %1", Формат(НастройкиОтображенияУзла.ТолщинаЛинии, "ЧН=0; ЧГ=0")));
