	//БазовыйСдвигПакета = ?(ЭтотОбъект.НаправлениеПостроения, 0, 500;
	
	НастройкиОтображенияУзловИРебер = Новый Структура("НастройкиСпецУзловИРебер, БазовыйСдвигУзла", НастройкиСпецУзловИРебер, БазовыйСдвигУзла );
	
	МассивИдентификаторовРебер = Новый Массив;
	
    ИдентификаторCREATE = "CREATE_";
	ИдентификаторINSERT = "INSERT_";
	
	МассивУзлы 		= Новый Массив;
	МассивРебра 	= Новый Массив;
	ИменаВременныхТаблиц = Новый Массив;
	
	
	МассивКластеры	= Новый Массив;
	
	X = 0;
	Y = 0;
	
	Для ИндексПакета = 0 По СхемаЗапросаVIS.ВГраница() Цикл
		
		ИскатьУзелВыборки 		= Истина;
		
		ТекущийПакет = СхемаЗапросаVIS[ИндексПакета];
		СоответствиеКластеров = Новый Соответствие;
		СоответствиеУзловКластерам = Новый Соответствие;
	    КоординатыУзлов = Новый Соответствие;
		
		Если ЭтотОбъект.НаправлениеПостроения Тогда // Пакеты по-вертикали, узлы по-горизонтали(1)
			Y = Y + ЭтотОбъект.СдвигПакета;
			X = 0;			
		Иначе                            // Узлы по-вертикали, пакеты по-горизонтали(0)
			X = X + ЭтотОбъект.СдвигПакета;
			Y = 0;		
		КонецЕсли;
		
		//X = X + БазовыйСдвигПакета;
		//Y = 0;
		Если ТипЗнч(ТекущийПакет) = Тип("Соответствие") Тогда
			
			ТекущийУзел = ТекущийПакет;
