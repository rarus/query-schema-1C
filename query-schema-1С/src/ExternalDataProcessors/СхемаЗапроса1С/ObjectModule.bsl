Функция СформироватьHTMLПоБлокам(head, css, div, variables, network, functions, Отладка = Ложь)
	
	СтрокиHTMLДокумента = Новый Массив;
	
	//html
	СтрокиHTMLДокумента.Добавить("<html>");
	
	//	head
	СтрокиHTMLДокумента.Добавить("	<head>");
	СтрокиHTMLДокумента.Добавить(head);
	СтрокиHTMLДокумента.Добавить("	</head>");
	
	//	------------
	//body
	СтрокиHTMLДокумента.Добавить("	<body>");
	
	//СтрокиHTMLДокумента.Добавить("	<style>");
	//СтрокиHTMLДокумента.Добавить(css);
	//СтрокиHTMLДокумента.Добавить("	</style>");
	
	СтрокиHTMLДокумента.Добавить(div);
		
	//	script
	СтрокиHTMLДокумента.Добавить("		<script type='text/javascript'>");
	
	Если Отладка Тогда
		СтрокиHTMLДокумента.Добавить("		 try { ");
	КонецЕсли;
	
	СтрокиHTMLДокумента.Добавить(variables);	
	
    СтрокиHTMLДокумента.Добавить(network);
	
	//СтрокиHTMLДокумента.Добавить(ОбработчикиПослеФормирования);
	
	СтрокиHTMLДокумента.Добавить(functions);
	
	Если Отладка Тогда
		СтрокиHTMLДокумента.Добавить("		} catch (e) {	alert(e); } ");
	КонецЕсли;
	
	СтрокиHTMLДокумента.Добавить("		</script>");
	СтрокиHTMLДокумента.Добавить("	</body>");
	СтрокиHTMLДокумента.Добавить("</html>");
	
	Возврат СтрСоединить(СтрокиHTMLДокумента, Символы.ПС);

