&НаКлиенте
Функция СформироватьДиаграмму_PlantUML()
	
	Элементы.СохранитьКартинкуPlantUML.Доступность = ЛОЖЬ;
	
	Если ЭтоТекстЗапроса1С() Тогда
		Успешно = СформироватьДиаграмму_PlantUML_Запрос1С();
	Иначе
		Успешно = СформироватьДиаграмму_PlantUML_ЗапросSQL();
	КонецЕсли;
	
	// Проверим результат построения диаграммы
	Если НЕ Успешно Тогда
		Возврат Ложь;
	КонецЕсли;
	Элементы.СохранитьКартинкуPlantUML.Доступность = ИСТИНА;
	
	Документ = Элементы.ПолеСхемыPlantUML.Документ;
	Если Документ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Получаем объект window
	ОкноHTML = Документ.defaultView;
	Если ОкноHTML = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Вызываем наш метод
	ОкноHTML.LoadSVG_as_TEXT(ЭтотОбъект.КартинкаSVG);
	Возврат Истина;
	
КонецФункции // СформироватьДиаграмму_PlantUML()

&НаСервере
Функция СформироватьДиаграмму_PlantUML_Запрос1С()
	
	ЗаписатьОперациюБизнесСтатистики("Формирование.PlantUML.Запрос1С", СтрЧислоСтрок(ЭтотОбъект.ТекстЗапроса));
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ИменаТаблиц  = Неопределено;
	СхемаЗапроса = ОбработкаОбъект.ПолучитьСхемуЗапроса1С(ЭтотОбъект.ТекстЗапроса, ЭтотОбъект.ИзмененныйЗапрос, ИменаТаблиц);
	
	ЭтотОбъект.ТекстPlantUML = ОбработкаОбъект.Сформировать_ТекстPlantUML_СхемаЗапроса1С(СхемаЗапроса, ИменаТаблиц);
	ЭтотОбъект.КартинкаSVG   = ОбработкаОбъект.СформироватьДиаграммуНаСервисеPlantUML(ЭтотОбъект.ТекстPlantUML);
	
	Возврат НЕ ПустаяСтрока(ЭтотОбъект.КартинкаSVG);
	
КонецФункции // СформироватьДиаграмму_PlantUML_Запрос1С()

&НаСервере
Функция СформироватьДиаграмму_PlantUML_ЗапросSQL()
	
	ЗаписатьОперациюБизнесСтатистики("Формирование.PlantUML.SQL", СтрЧислоСтрок(ЭтотОбъект.ТекстЗапроса));
	
	СхемаЗапросаSQL = JSONВЗначение(ЭтотОбъект.ТекстJSON);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ЭтотОбъект.ТекстPlantUML = ОбработкаОбъект.Сформировать_ТекстPlantUML_СхемаЗапросаSQL(СхемаЗапросаSQL);
	ЭтотОбъект.КартинкаSVG   = ОбработкаОбъект.СформироватьДиаграммуНаСервисеPlantUML(ЭтотОбъект.ТекстPlantUML);
	
	Возврат НЕ ПустаяСтрока(ЭтотОбъект.КартинкаSVG);
	
КонецФункции // СформироватьДиаграмму_PlantUML_ЗапросSQL()

