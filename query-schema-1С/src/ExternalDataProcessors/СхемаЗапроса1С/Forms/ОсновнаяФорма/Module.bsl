#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Определим имя объекта метаданных обработки
	ЧастиИмени = СтрРазделить(ЭтотОбъект.ИмяФормы, ".", Ложь);
	ИмяОбъекта = ЧастиИмени[0] + "." + ЧастиИмени[1];
	
	// Задаем параметры диаграмм PlantUML по умолчанию
	Объект.КомпактныйРежим           = Истина;
	Объект.ПрямыеСтрелки             = Истина;
	Объект.ВыводитьУсловияСоединения = Ложь;
	Объект.РасположитьСЛевоНаПраво   = Ложь;
	
	Объект.СворачиватьПромежуточныеУзлы = Истина;
	Объект.Физика                       = Истина;
	Объект.СдвигПакета                  = 500;
	Объект.СдвигУзла                    = 150;
	
	// Посмотрим что было передано при открытии формы
	Если ЭтотОбъект.Параметры.Свойство("ТекстЗапроса") Тогда
		ЭтотОбъект.ТекстЗапроса = ЭтотОбъект.Параметры.ТекстЗапроса;
	КонецЕсли;
	Если ЭтотОбъект.Параметры.Свойство("ВидДиаграммы") Тогда
		ЭтотОбъект.ВидДиаграммы = ЭтотОбъект.Параметры.ВидДиаграммы;
	КонецЕсли;
	
	// Производим инициализацию поля PlantUML
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ПолеСхемыPlantUML = ОбработкаОбъект.ПолучитьМакет("ШаблонПоляPlantUML").ПолучитьТекст();
	ЗаставкаPlantUML  = ОбработкаОбъект.ПолучитьМакет("ЗаставкаPlantUML");
	
	// Устанавливаем картинку заставки
	ЭтотОбъект.КартинкаSVG = ПолучитьСтрокуИзДвоичныхДанных(ЗаставкаPlantUML, КодировкаТекста.UTF8);
	
	// Заполним меню примеров
	ЗаполнитьПримерыТекстовЗапросов();
	
	ЗаписатьОперациюБизнесСтатистики("ОткрытиеФормы");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВидДиаграммыПриИзменении(Неопределено);
	ПоказатьДанныеСхемы(Неопределено);
	ПодключитьОбработчикОжидания("ВывестиЗаставкуPlantUML", 0.1, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ВидДиаграммыПриИзменении(Команда)
	
	Если Команда<>Неопределено Тогда
		ЭтоPlantUML(Команда=ЭтотОбъект.Команды.ВидДиаграммыPlantUML);
	КонецЕсли; 
	
	Если ЭтоPlantUML() Тогда
		Элементы.ГруппаДиаграмма.ТекущаяСтраница = Элементы.СтраницаСхемаPlantUML;
		Элементы.ВидДиаграммыPlantUML     .Пометка   = Истина;
		Элементы.ВидДиаграммыVISJS        .Пометка   = Ложь;
		Элементы.СохранитьКартинкуPlantUML.Видимость = Истина;
	Иначе
		Элементы.ГруппаДиаграмма.ТекущаяСтраница = Элементы.СтраницаСхемаVISJS;
		Элементы.ВидДиаграммыPlantUML     .Пометка   = Ложь;
		Элементы.ВидДиаграммыVISJS        .Пометка   = Истина;
		Элементы.СохранитьКартинкуPlantUML.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеСхемыVISJSПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	ПросмотрПоУмолчанию 	= Элемент.Документ.DefaultView;
	
	ИмяСобытия 		= ПросмотрПоУмолчанию.EventName;
	ОписаниеСобытия	= ПросмотрПоУмолчанию.EventDescription;
	
	Если НЕ ЗначениеЗаполнено(ИмяСобытия) Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяСобытия = "ДвойноеНажатие" И ЗначениеЗаполнено(ОписаниеСобытия) Тогда
		
		ОписаниеСобытияJSON = JSONВЗначение(ОписаниеСобытия);
		МассивУзлов = ОписаниеСобытияJSON.Получить("nodes");
		МассивРебер = ОписаниеСобытияJSON.Получить("edges");
		НавигационнаяСсылкаДляПерехода = "";
		
		Если ТипЗнч(МассивУзлов) = Тип("Массив") 
			И МассивУзлов.Количество() Тогда        //Считаем что нажали на узел
			ЭтоУзел = Истина;
			ИдентификаторЭлемента 	= МассивУзлов[0];
			ВывестиПолныйЗаголовокВОтдельномОкне(ПросмотрПоУмолчанию, ИдентификаторЭлемента, ЭтоУзел);
			
		ИначеЕсли ТипЗнч(МассивРебер) = Тип("Массив") 
			И МассивРебер.Количество() Тогда        //Считаем что нажали на ребро
			ЭтоУзел = Ложь;
			ИдентификаторЭлемента = МассивРебер[0];
			ВывестиПолныйЗаголовокВОтдельномОкне(ПросмотрПоУмолчанию, ИдентификаторЭлемента, ЭтоУзел);								
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НавигационнаяСсылкаДляПерехода) Тогда
			ПерейтиПоНавигационнойСсылке(НавигационнаяСсылкаДляПерехода);				
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяСобытия <> "Ошибка" Тогда
		ПросмотрПоУмолчанию.EventName = "";	
		ПросмотрПоУмолчанию.EventDescription = "";	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаЗапросПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Элементы.ОбновитьСТекущимиДанными.Доступность = НЕ ТекущаяСтраница.ТолькоПросмотр;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура СформироватьДиаграмму(Команда)
	
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	// Очищаем служебные данные
	ЭтотОбъект.ИзмененныйЗапрос = "";
	ЭтотОбъект.ТекстPlantUML    = "";
	ЭтотОбъект.ТекстJSON        = "";
	ЭтотОбъект.КартинкаSVG      = "";
	
	// Получение объектной модели SQL запроса выполняется асинхронно, выполним отдельно
	Если НЕ ЭтоТекстЗапроса1С() Тогда
		
		ЭтотОбъект.ТекстJSON = Ждать ПолучитьСхемуЗапросаSQL(ЭтотОбъект.ТекстЗапроса, Объект.ПутьКПитону, ЭтоPlantUML());
		Если ПустаяСтрока(ЭтотОбъект.ТекстJSON) Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	// Производим построение 
	Если ЭтоPlantUML() Тогда
		СформироватьДиаграмму_PlantUML();
	Иначе
		СформироватьДиаграмму_VISJS();
	КонецЕсли;
	
КонецПроцедуры // СформироватьДиаграмму()

&НаКлиенте
Асинх Процедура СохранитьКартинкуPlantUML(Команда)
	
	Если ПустаяСтрока(ТекстЗапроса) ИЛИ НЕ ЗначениеЗаполнено(ЭтотОбъект.КартинкаSVG) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайла = СтрШаблон(НСтр("ru = 'Схема запроса %1.svg'"), Формат(ТекущаяДата(), "ДФ=yyyyMMddЧЧммсс"));
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок      = НСтр("ru = 'Выберите каталог для сохранения схемы запроса'");
	Диалог.ПолноеИмяФайла = ИмяФайла;
	Диалог.Фильтр         = НСтр("ru = 'Картинка (*.svg)'")+"|*.svg";
	
	Ответ = Ждать Диалог.ВыбратьАсинх();
	Если Ответ=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьТекстВФайл(Диалог.ПолноеИмяФайла, ЭтотОбъект.КартинкаSVG);
	
КонецПроцедуры // СохранитьКартинкуPlantUML()

&НаКлиенте
Процедура Настройки(Команда)
	
	ОткрытьФорму(ИмяОбъекта+".Форма.Настройки", Новый Структура("Объект", ЭтотОбъект.Объект), ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПримерНаСервере(ИмяМакета)
	
	ТекстЗапроса = РеквизитФормыВЗначение("Объект").ПолучитьМакет(ИмяМакета).ПолучитьТекст();
	ЗаписатьОперациюБизнесСтатистики("ЗагрузитьПример."+ИмяМакета);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПример(Команда)
	
	ЗагрузитьПримерНаСервере(Команда.Имя);
	СформироватьДиаграмму(Команда);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДанныеСхемы(Команда)
	
	Если Команда<>Неопределено Тогда
		Объект.Отладка = НЕ Объект.Отладка;		
	КонецЕсли;
	
	Элементы.ПоказатьДанныеСхемы.Пометка = Объект.Отладка;
	
	Если Не Объект.Отладка Тогда
		Элементы.ГруппаЗапрос.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		Элементы.ГруппаЗапрос.ТекущаяСтраница    = Элементы.СтраницаТекстЗапроса;
	Иначе
		Элементы.ГруппаЗапрос.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
	КонецЕсли;
	
	Страница = Элементы.ГруппаЗапрос.ТекущаяСтраница;
	Элементы.ОбновитьСТекущимиДанными.Доступность = НЕ(Страница.ТолькоПросмотр ИЛИ Страница=Элементы.СтраницаТекстЗапроса);
	Элементы.ОбновитьСТекущимиДанными.Видимость   = Объект.Отладка;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСТекущимиДанными(Команда)
	
	Страница = Элементы.ГруппаЗапрос.ТекущаяСтраница;
	Если Страница.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	Если Страница=Элементы.СтраницаPlantUML Тогда
		
		Если ПустаяСтрока(ЭтотОбъект.ТекстPlantUML) Тогда
			Возврат;
		КонецЕсли;
		
		ОбновитьКартинкуPlantUML();
		
		Документ = Элементы.ПолеСхемыPlantUML.Документ;
		Если Документ = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		// Получаем объект window
		ОкноHTML = Документ.defaultView;
		Если ОкноHTML = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		// Вызываем наш метод
		ОкноHTML.LoadSVG_as_TEXT(ЭтотОбъект.КартинкаSVG);
		
	ИначеЕсли Страница=Элементы.СтраницаVISJS Тогда
		Если ПустаяСтрока(ЭтотОбъект.ПолеСхемыVISJS) Тогда
			Возврат;
		КонецЕсли;
		ПодключитьОбработчикОжидания("Подключаемый_СформироватьДиаграмму_VISJS", 0.2, Истина);
		
	ИначеЕсли Страница=Элементы.СтраницаУзлыVISJS Тогда
		Если ПустаяСтрока(ЭтотОбъект.УзлыJS) Тогда
			Возврат;
		КонецЕсли;
		Подключаемый_СформироватьДиаграмму_VISJS();
		
	ИначеЕсли Страница=Элементы.СтраницаРебраVISJS Тогда
		Если ПустаяСтрока(ЭтотОбъект.РебраJS) Тогда
			Возврат;
		КонецЕсли;
		Подключаемый_СформироватьДиаграмму_VISJS();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура КонструкторЗапроса(Команда)
	
	ИмяРеквизитаЗапроса =
		?(ЭтотОбъект.ТекущийЭлемент = Элементы.ИзмененныйЗапрос, "ИзмененныйЗапрос", "ТекстЗапроса");
	
	Конструктор = Новый КонструкторЗапроса;
	Попытка
		Конструктор.Текст = ЭтотОбъект[ИмяРеквизитаЗапроса];
	Исключение
		ПоказатьМестоОшибкиЗапроса1С(ИнформацияОбОшибке(), Элементы.ТекстЗапроса);
		Возврат;
	КонецПопытки;
	
	Результат = Ждать Конструктор.ОткрытьАсинх();
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект[ИмяРеквизитаЗапроса] = Результат;
	
КонецПроцедуры // КонструкторЗапроса()

&НаКлиенте
Процедура ВывестиПолныйЗаголовокВОтдельномОкне(ПросмотрПоУмолчанию, ИдентификаторЭлемента, ЭтоУзел = Истина)
	
	Если ЭтоУзел Тогда
		ИмяЭлемента 	= ПросмотрПоУмолчанию.getNodeProperty(ИдентификаторЭлемента,"label");
		ПолныйЗаголовок = ПросмотрПоУмолчанию.getNodeProperty(ИдентификаторЭлемента,"fulltitle");
	Иначе
		
		ИмяУзла1 = ПросмотрПоУмолчанию.getNodeProperty(ПросмотрПоУмолчанию.getEdgeProperty(ИдентификаторЭлемента,"to"),"label");
		ИмяУзла2 = ПросмотрПоУмолчанию.getNodeProperty(ПросмотрПоУмолчанию.getEdgeProperty(ИдентификаторЭлемента,"from"),"label");
		
		ИмяЭлемента 	= СтрШаблон("Соединение узлов '%1' и '%2'", ИмяУзла1, ИмяУзла2);
		ПолныйЗаголовок = ПросмотрПоУмолчанию.getEdgeProperty(ИдентификаторЭлемента,"fulltitle");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПолныйЗаголовок) Тогда
		ПолныйЗаголовок = СтрЗаменить(ПолныйЗаголовок, "<br>", Символы.ПС);
		ОткрытьФорму(ИмяОбъекта+".Форма.ВыводЭлемента", Новый Структура("ТекстЗапроса,ИмяЭлемента", ПолныйЗаголовок, ИмяЭлемента));
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ОПрограмме(Команда)
	
	ИмяОбъектаМетаданных = СтрРазделить(ЭтотОбъект.ИмяФормы, ".", Ложь);
	ОткрытьФорму(ИмяОбъектаМетаданных[0] + "." + ИмяОбъектаМетаданных[1] + ".Форма.ОПрограмме",, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Общее

&НаСервереБезКонтекста
Процедура ЗаписатьОперациюБизнесСтатистики(ИмяОперации, Значение = 1, Комментарий = "")
	
	// Проверим, есть ли подсистема мониторинга
	Если Метаданные.ОбщиеМодули.Найти("ЦентрМониторинга") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// АПК:488-выкл Модуля может не быть в системе, обходим синтаксис контроль платформы
	МодульЦентрМониторинга = Вычислить("ЦентрМониторинга");
	// АПК:488-вкл
	
	УстановитьПривилегированныйРежим(ИСТИНА);
	Попытка
		ИмяОперации = "Инструменты.СхемаЗапроса1С." + ИмяОперации;
		МодульЦентрМониторинга.ЗаписатьОперациюБизнесСтатистики(ИмяОперации, Значение, Комментарий);
	Исключение
		Причина = ИнформацияОбОшибке();
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПримерыТекстовЗапросов()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ЗагрузитьПример = ЭтотОбъект.Команды["ЗагрузитьПример"];
	Элементы.ФормаЗагрузитьПример.Видимость = Ложь;
	
	Для каждого Макет Из ОбработкаОбъект.Метаданные().Макеты Цикл
		
		Если НЕ СтрНачинаетсяС(ВРег(Макет.Имя), ВРег("Пример")) Тогда
			Продолжить;
		КонецЕсли;
		
		Команда = ЭтотОбъект.Команды.Добавить(Макет.Имя);
		Команда.Заголовок = Макет.Синоним;
		Команда.Картинка = ЗагрузитьПример.Картинка;
		Команда.Действие = ЗагрузитьПример.Действие;
		
		Кнопка = Элементы.Добавить(Макет.Имя, Тип("КнопкаФормы"), Элементы.ГруппаПримеры);
		Кнопка.Заголовок  = Макет.Синоним;
		Кнопка.ИмяКоманды = Команда.Имя;
		Кнопка.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанели;
		
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьПримерыТекстовЗапросов()

&НаКлиенте
Функция ЭтоТекстЗапроса1С()
	
	// Пустое поле проще обработать как запрос 1С
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	// Производим идентификацию типа запроса по ключевым словам
	КлючевыеСлова = Новый Структура("ВЫБРАТЬ,SELECT,INSERT,UPDATE,DELETE,CREATE,DROP,RENAME,ALTER,GRANT,REVOKE,DENY,COMMIT,ROLLBACK,BEGIN", ИСТИНА);
	Для каждого Оператор Из КлючевыеСлова Цикл
		
		// Если найдено ключевое слово, то считаем что тип запроса определен
		Если СтрНайти(ВРег(ТекстЗапроса), Оператор.Ключ)<>0 Тогда
			Возврат (Оператор.Значение=ИСТИНА);
		КонецЕсли;
		
	КонецЦикла;
	
	// Ничего не нашли, предупредим пользователя
	ВызватьИсключение НСтр("ru = 'Ожидается выражение ""ВЫБРАТЬ""'");
	
КонецФункции

&НаКлиенте
Функция ЭтоPlantUML(УстановитьКакPlantUML=Неопределено)
	
	ВидPlantUML = 0;
	ВидVISJS    = 1;
	
	// Если находимся в режиме проверки, то возвращаем значение
	Если УстановитьКакPlantUML=Неопределено Тогда
	    Возврат (ВидДиаграммы=ВидPlantUML);
	КонецЕсли;
	
	// Производим установку значения режима
	ВидДиаграммы = ?(УстановитьКакPlantUML, ВидPlantUML, ВидVISJS);
	Возврат Неопределено;
	
КонецФункции // ЭтоPlantUML()

&НаКлиенте
Процедура ПоказатьМестоОшибкиЗапроса1С(Причина, Элемент)
	
	Сообщить(КраткоеПредставлениеОшибки(Причина), СтатусСообщения.Важное);
	Описание = Причина.Причина.Описание;
	
	НачалоБлока = СтрНайти(Описание, "{(");
	КонецБлока  = СтрНайти(Описание, ")}");
	
	ЧастиАдреса = СтрРазделить(Сред(Описание, НачалоБлока+2, КонецБлока-НачалоБлока-2), ",", ЛОЖЬ);
	Если ЧастиАдреса.Количество()=2 Тогда
		НачалоСтроки  = Число(ЧастиАдреса[0]);
		НачалоКолонки = Число(СокрЛП(ЧастиАдреса[1]));
		Элемент.УстановитьГраницыВыделения(НачалоСтроки, НачалоКолонки, НачалоСтроки, НачалоКолонки);
	КонецЕсли;
	
КонецПроцедуры // ПоказатьМестоОшибкиЗапроса1С()

&НаКлиенте
Процедура ВывестиЗаставкуPlantUML()
	
	Документ = Элементы.ПолеСхемыPlantUML.Документ;
	Если Документ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОкноHTML = Документ.defaultView;
	Если ОкноHTML = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОкноHTML.LoadSVG_as_TEXT(ЭтотОбъект.КартинкаSVG);
	
КонецПроцедуры // ВывестиЗаставкуPlantUML()

&НаСервере
Процедура ОбновитьКартинкуPlantUML()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ЭтотОбъект.КартинкаSVG = ОбработкаОбъект.СформироватьДиаграммуНаСервисеPlantUML(ЭтотОбъект.ТекстPlantUML);
КонецПроцедуры

// Преобразует строку в формате JSON в значение при помощи метода глобального контекста ПрочитатьJSON.
// См. ограничения в синтакс-помощнике.
// Объекты JSON по умолчанию преобразует в значения типа Соответствие. 
// Имена свойств со значением типа Дата необходимо явно указывать, чтобы было выполнено преобразование.
// Ожидаемый формат дат - ISO (YYYY-MM-DDThh:mm:ssZ).
// 
// Параметры:
//   Строка - Строка - значение в формате JSON.
//   ИменаСвойствСоЗначениямиДата - Строка - имя свойства, содержащее значение типа Дата. Допустимо указывать несколько
//                                           свойств через запятую.
//                                - Массив из Строка 
//   ПрочитатьВСоответствие       - Булево - если Ложь, то объекты JSON будут преобразованы в значение типа Структура.
//   
// Возвращаемое значение:
//  Произвольный
//
&НаСервереБезКонтекста
Функция JSONВЗначение(Знач Строка, Знач ИменаСвойствСоЗначениямиДата = Неопределено, Знач ПрочитатьВСоответствие = Истина) Экспорт
	
	Если ТипЗнч(ИменаСвойствСоЗначениямиДата) = Тип("Строка") Тогда
		ИменаСвойствСоЗначениямиДата = СтрРазделить(ИменаСвойствСоЗначениямиДата, ", " + Символы.ПС, Ложь);
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Строка);
	
	Возврат ПрочитатьJSON(ЧтениеJSON, ПрочитатьВСоответствие, ИменаСвойствСоЗначениямиДата);
	
КонецФункции // JSONВЗначение()

#КонецОбласти

