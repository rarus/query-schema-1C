#Область ПереводЗапросаSQLВJSON

// Сериализует текст SQL-запроса в формат JSON с помощью внешнего Python-скрипта.
// Выполняет распаковку необходимых скриптов, установку зависимостей через pip и запуск парсера.
//
// Параметры:
//  ТекстSQL      - Строка - Исходный текст SQL-запроса для обработки.
//  ПутьКПитону   - Строка - Полный путь к исполняемому файлу Python (python.exe).
//  РежимPlantUML - Булево - Настройки визуализации и парсинга: "vis" или "plant".
//
// Возвращаемое значение:
//  Строка - Результат сериализации в формате JSON. В случае ошибки возвращает пустую строку.
//
&НаКлиенте
Асинх Функция ПолучитьСхемуЗапросаSQL(ТекстSQL, ПутьКПитону, РежимPlantUML) Экспорт
	
	#Если ВебКлиент Тогда
	Сообщить(НСтр("ru = 'Построение диаграммы по SQL-запросу в веб-клиенте не поддерживается.'"));
	Возврат "";
	#КонецЕсли
	
	Состояние(НСтр("ru='Распаковка файлов сериализатора SQL-запросов'"), 0);
	
	// Пути к файлам.
	ПутьККаталогуСкриптов = СтрШаблон("%1%2", 
		Ждать КаталогВременныхФайловАсинх(),
		"sql_serialize"
	);
	ПутьКИсполняемомуСкрипту = СтрШаблон("%1%2%3%4%5", 
		ПутьККаталогуСкриптов,
		ПолучитьРазделительПути(),
		"sql_visualisation-master",
		ПолучитьРазделительПути(),
		"tree_sql_query.py"
	);
	
	// ПутьКИсполняемомуФайлу
	ИмяИсполняемогоФайла = "";
	Система = Новый СистемнаяИнформация;
	ЭтоWindowsКлиент = (Система.ТипПлатформы=ТипПлатформы.Windows_x86 ИЛИ Система.ТипПлатформы=ТипПлатформы.Windows_x86_64);
	ЭтоLinuxКлиент   = (Система.ТипПлатформы=ТипПлатформы.Linux_x86   ИЛИ Система.ТипПлатформы=ТипПлатформы.Linux_x86_64
							ИЛИ Система.ТипПлатформы=ТипПлатформы.Linux_ARM64 ИЛИ Система.ТипПлатформы=ТипПлатформы.Linux_E2K);
	Если ЭтоWindowsКлиент Тогда
		ИмяИсполняемогоФайла = "tree_sql_query_win_x64.exe";
	ИначеЕсли ЭтоLinuxКлиент Тогда
		ИмяИсполняемогоФайла = "tree_sql_query_linux_x64_glibc2.39";
	Иначе
		Сообщить(СтрШаблон(НСтр("ru = 'Построение диаграммы по SQL-запросу в операционной системе %1 не поддерживается.'"), Система.ТипПлатформы));
		Возврат "";
	КонецЕсли;
	ПутьКИсполняемомуФайлу = СтрШаблон("%1%2%3", 
		ПутьККаталогуСкриптов,
		ПолучитьРазделительПути(),
		ИмяИсполняемогоФайла
	);
	
	ИдентификаторФайла = Новый УникальныйИдентификатор;
	БазовоеИмяФайла = СтрШаблон("%1%2%3%4", 
		Ждать КаталогВременныхФайловАсинх(),
		"sql_serialize_", 
		ИдентификаторФайла
	);
	ПутьКФайлуЛога = СтрШаблон("%1.%2", БазовоеИмяФайла, "log");
	ПутьКФайлуSQL = СтрШаблон("%1.%2", БазовоеИмяФайла, "sql");
	ПутьКФайлуJSON = СтрШаблон("%1.%2", БазовоеИмяФайла, "json");
	ПутьКФайлуZIP = СтрШаблон("%1.%2", БазовоеИмяФайла, "zip");
	//ПутьКФайлуZIP = ПолучитьИмяВременногоФайла("zip");
	КаталогZIP = Ждать КаталогВременныхФайловАсинх();
	ИмяФайлаZIP = Строка(Новый УникальныйИдентификатор) + ".zip";
	ПутьКФайлуZIP = КаталогZIP + ИмяФайлаZIP;
	СписокУдалитьВКонце = Новый Массив;
	//СписокУдалитьВКонце.Добавить(ПутьККаталогуСкриптов);
	СписокУдалитьВКонце.Добавить(ПутьКФайлуZIP);
	СписокУдалитьВКонце.Добавить(ПутьКФайлуЛога);
	СписокУдалитьВКонце.Добавить(ПутьКФайлуSQL);
	СписокУдалитьВКонце.Добавить(ПутьКФайлуJSON);
	
	// Проверка версии скриптов, чтобы не выгружать заново.
	АктуальнаяВерсияСкриптов = АктуальнаяВерсияСкриптов();
	СтараяВерсияСкриптов = "-1";
	ПутьКФайлуСтаройВерсии = СтрШаблон("%1%2%3", 
		ПутьККаталогуСкриптов,
		ПолучитьРазделительПути(),
		"version.txt"
	);
	ФайлСтаройВерсии = Новый Файл(ПутьКФайлуСтаройВерсии);
	Если Ждать ФайлСтаройВерсии.СуществуетАсинх() Тогда
		СтараяВерсияСкриптов = СокрЛП(Ждать ПолучитьТекстФайла(ПутьКФайлуСтаройВерсии, КодировкаТекста.UTF8));
	КонецЕсли;
	Если АктуальнаяВерсияСкриптов <> СтараяВерсияСкриптов Тогда
		// Выгрузка скриптов.
		АрхивСкриптов = ПолучитьИзВременногоХранилища(ПолучитьАдресАрхиваСкриптов());
		АрхивСкриптов.Записать(ПутьКФайлуZIP);
		КаталогНаДиске = Новый Файл(ПутьККаталогуСкриптов);
		Если Ждать КаталогНаДиске.СуществуетАсинх() Тогда
			Ждать УдалитьФайлыАсинх(ПутьККаталогуСкриптов, "*.*");
		КонецЕсли;
		Ждать СоздатьКаталогАсинх(ПутьККаталогуСкриптов);
		Попытка
			Архив = Новый(Тип("ЧтениеФайлаАрхива"));
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			Архив = Новый(Тип("ЧтениеZipФайла"));
		КонецПопытки;
		Попытка
			Архив.Открыть(ПутьКФайлуZIP);
			Архив.ИзвлечьВсе(ПутьККаталогуСкриптов);
			Архив.Закрыть();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			Сообщить(СтрШаблон("%1%2", 
				НСтр("ru = 'Ошибка при распаковке: '"),
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке)
			));
			Ждать УдалитьВременныеФайлы(СписокУдалитьВКонце);
			Возврат "";
		КонецПопытки;
	КонецЕсли;
	
	РезультатЗаписи = Ждать ЗаписатьТекстВФайл(ПутьКФайлуSQL, ТекстSQL);
	
	ВыходнойФормат = ?(РежимPlantUML, "plant", "vis");
	
	Если ЗначениеЗаполнено(ПутьКПитону) Тогда
	
		// Установка библиотек
		ПутьКТребованиямПитона = СтрШаблон("%1%2%3%4%5", 
			ПутьККаталогуСкриптов,
			ПолучитьРазделительПути(),
			"sql_visualisation-master",
			ПолучитьРазделительПути(),
			"requirements.txt"
		);
		СтрокаЗапуска = СтрШаблон("""%1"" -m pip install -r ""%2""",
			ПутьКПитону,
			ПутьКТребованиямПитона
		);
		Состояние(НСтр("ru='Установка необходимых библиотек python'"), 10);
		Если НЕ Ждать ЗапуститьПриложениеВывестиВФайл(СтрокаЗапуска, ПутьКФайлуЛога) Тогда
			Сообщить(СтрШаблон("%1%2", 
				НСтр("ru = 'Ошибка установки библиотек по причине: '"), 
				Ждать ПолучитьТекстФайла(ПутьКФайлуЛога)
			));
			УдалитьВременныеФайлы(СписокУдалитьВКонце);
			Возврат "";
		КонецЕсли;
		
		// Запуск скрипта python.
		ПараметрыПитона = Новый Массив;
		ПараметрыПитона.Добавить(ПутьКПитону);
		ПараметрыПитона.Добавить(ПутьКИсполняемомуСкрипту);
		ПараметрыПитона.Добавить(СтрШаблон("--input ""%1""", ПутьКФайлуSQL));
		ПараметрыПитона.Добавить(СтрШаблон("--output ""%1""", ПутьКФайлуJSON));
		ПараметрыПитона.Добавить(СтрШаблон("--format ""%1""", ВыходнойФормат));
		СтрокаЗапуска = СтрСоединить(ПараметрыПитона, " ");
		
	Иначе
		
		// Запуск скрипта из exe.
		ПараметрыЗапускаСкрипта = Новый Массив;
		ПараметрыЗапускаСкрипта.Добавить(ПутьКИсполняемомуФайлу);
		ПараметрыЗапускаСкрипта.Добавить(СтрШаблон("--input ""%1""", ПутьКФайлуSQL));
		ПараметрыЗапускаСкрипта.Добавить(СтрШаблон("--output ""%1""", ПутьКФайлуJSON));
		ПараметрыЗапускаСкрипта.Добавить(СтрШаблон("--format ""%1""", ВыходнойФормат));
		СтрокаЗапуска = СтрСоединить(ПараметрыЗапускаСкрипта, " ");
		
	КонецЕсли;
	
	Состояние(НСтр("ru='Запуск скрипта сериализатора SQL-запросов'"), 60);
	
	Если НЕ Ждать ЗапуститьПриложениеВывестиВФайл(СтрокаЗапуска, ПутьКФайлуЛога) Тогда
		Сообщить(СтрШаблон("%1%2", 
			НСтр("ru = 'Ошибка запуска скрипта по причине: '"),
			Ждать ПолучитьТекстФайла(ПутьКФайлуЛога, КодировкаТекста.ANSI)
		));
		Ждать УдалитьВременныеФайлы(СписокУдалитьВКонце);
		Возврат "";
	КонецЕсли;
	
	Состояние(НСтр("ru='Получение объектной модели SQL-запроса'"), 100);
	
	ТекстJSON = Ждать ПолучитьТекстФайла(ПутьКФайлуJSON);
	Ждать УдалитьВременныеФайлы(СписокУдалитьВКонце);
	Возврат ТекстJSON;
	
КонецФункции // ПолучитьСхемуЗапросаSQL()

// Функция - ЗапуститьПриложениеВывестиВФайл
//
// Параметры:
//  ТекстКоманды	 - 	 - Текст команды которую необходимо выполнить приложению
//  ПутьКФайлуВывода - 	 - Путь к файлу, в который будет произведен вывод стандартного выходного
// 
// Возвращаемое значение:
//   - Будево значение была ошибка или нет
//
&НаКлиенте
Асинх Функция ЗапуститьПриложениеВывестиВФайл(ТекстКоманды, ПутьКФайлуВывода)
	// Для того чтобы перенаправить выходной поток в файл, создадим bat файл и выполним его
	ИдентификаторФайла = Новый УникальныйИдентификатор;
	ПутьКБат = Ждать КаталогВременныхФайловАсинх() + "\sql_serialize_" + ИдентификаторФайла + ".bat";

	БатТекст = Новый ЗаписьТекста(ПутьКБат, КодировкаТекста.ANSI);
	БатТекст.Закрыть();
	БатТекст = Новый ЗаписьТекста(ПутьКБат, , , Истина, Символы.ПС);
	
	//БатТекст = Новый ЗаписьТекста;
	//БатТекст.Открыть(ПутьКБат, КодировкаТекста.ANSI);
	БатТекст.ЗаписатьСтроку("@chcp 65001"); // Первой строкой устанавливаем кодировку
	// Второй строкой устанавливаем текст команды, которую необходимо выполнить
	// 1> - Перенаправление стандартного выходного потока в файл ПутьКФайлуВывода
	// 2>&1 - Перенаправление стандартного потока ошибок в тот же файл
	БатТекст.ЗаписатьСтроку(ТекстКоманды + " 1> """ + ПутьКФайлуВывода + """ 2>&1");
	БатТекст.Закрыть();

	КодВозврата = Ждать ЗапуститьПриложениеАсинх(ПутьКБат, , Истина);
	Если КодВозврата = Неопределено Тогда
		КодВозврата = 1;
	КонецЕсли;
	
	// После исполнения команды удалим временный файл
	Ждать УдалитьФайлыАсинх(ПутьКБат);
	Возврат (КодВозврата < 1);
КонецФункции

&НаКлиенте
Асинх Функция ПолучитьТекстФайла(ПутьКФайлу, Кодировка = Неопределено)
	Если Кодировка = Неопределено Тогда
		Кодировка = КодировкаТекста.UTF8;
	КонецЕсли;
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	Ждать ТекстовыйФайл.ПрочитатьАсинх(
		ПутьКФайлу,
		Кодировка
	);
	Возврат ТекстовыйФайл.ПолучитьТекст();
КонецФункции

&НаКлиенте
Асинх Функция ЗаписатьТекстВФайл(ПутьКФайлу, ТекстФайла)
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.УстановитьТекст(ТекстФайла);
	Ждать ТекстовыйФайл.ЗаписатьАсинх(
		ПутьКФайлу, 
		КодировкаТекста.UTF8
	);
	Возврат Истина;
КонецФункции

&НаКлиенте
Асинх Функция УдалитьВременныеФайлы(ВременныеФайлы)
	
	// Удаление временных файлов.
	Для каждого ФайлУдалить Из ВременныеФайлы Цикл
		ФайлОбъект = Новый Файл(ФайлУдалить);
		Если Ждать ФайлОбъект.СуществуетАсинх() Тогда
			Ждать УдалитьФайлыАсинх(ФайлУдалить);
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаСервере
Функция ПолучитьАдресАрхиваСкриптов() Экспорт
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("СкриптыСериализацииSQL");
	Возврат ПоместитьВоВременноеХранилище(Макет);
	
КонецФункции

&НаСервере
Функция АктуальнаяВерсияСкриптов() Экспорт
	
	Возврат РеквизитФормыВЗначение("Объект").Метаданные().Макеты.СкриптыСериализацииSQL.Комментарий;
	
КонецФункции

